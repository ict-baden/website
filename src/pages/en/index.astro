---
// Englische Übersicht der Produkte (/en/). Der Rest der Website ist deutsch; Kopf- und Fußzeile bleiben deutsch.
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { lineGlyph } from '../../lib/art';
import { linien, products, productsOfLine } from '../../lib/products';
import { LINE_EN, pageFor, productUrlFor, UI } from '../../lib/produktseiten';
import { breadcrumbs, organization, productList, webPage, website } from '../../lib/seo';
import { COMPANY } from '../../config';

const title = 'Software for industry, labs and IT – ICT Baden';
const description = 'Products by ICT Baden, Karlsruhe: transparent screen lock, QR and barcode reader, kiosk browser and keyboard for Zebra, Windows hardening and permission reports.';
const t = UI.en;
const statusEn = (p: (typeof products)[number]) => `${t.status[p.statusKey]}${p.statusKey === 'vorabversion' && p.version ? ` ${p.version}` : ''}`;
const jsonLd = [
  organization(),
  website(),
  webPage('/en/', title, description, 'en'),
  productList(products, 'en', 'Software products by ICT Baden'),
  breadcrumbs([{ name: 'ICT Baden', url: '/' }, { name: t.products, url: '/en/' }]),
];
---
<Base
  title={title}
  bareTitle
  description={description}
  lang="en"
  alternates={[{ lang: 'de', href: '/produkte/' }, { lang: 'en', href: '/en/' }]}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <nav aria-label={t.crumbs}>
        <ol class="crumbs">
          <li><a href="/">ICT Baden</a></li>
          <li><span aria-current="page">{t.products}</span></li>
        </ol>
      </nav>
      <p class="eyebrow">ICT Baden GmbH · Karlsruhe, Germany</p>
      <h1>Software products for industry, labs and IT</h1>
      <p class="lead">
        ICT Baden GmbH from Karlsruhe-Durlach, Germany, develops custom software and its own products for plants,
        laboratories, warehouses and IT departments. Every product below is free of charge under the MIT licence;
        support contracts with guaranteed response times are available.
      </p>
      <p class="en-note">
        The rest of this website is in German. <a href="/produkte/" hreflang="de" lang="de">Produkte auf Deutsch</a>
      </p>
    </div>
  </section>

  <div class="container catalog" id="products">
    {linien.map((l) => (
      <section class="pline" aria-labelledby={`h-${l.id}`}>
        <header class="pline-head">
          <span class="pline-icon" set:html={lineGlyph(l.id)} />
          <div>
            <h2 id={`h-${l.id}`}>{LINE_EN[l.id]?.name ?? l.name}</h2>
            <p>{LINE_EN[l.id]?.text ?? l.text}</p>
          </div>
        </header>
        <ul class="pgrid" role="list">
          {productsOfLine(l.id).map((p) => (
            <li>
              <ProductCard
                product={p}
                uid="-en"
                href={productUrlFor(p, 'en')}
                kind={pageFor(p).en.kind ?? p.kind}
                text={pageFor(p).en.description}
                statusLabel={statusEn(p)}
              />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="container about-en" aria-labelledby="about-en">
    <h2 id="about-en">About ICT Baden</h2>
    <p>
      {COMPANY.name}, {COMPANY.street}, {COMPANY.zip} {COMPANY.city}, Germany. Consulting and custom software development
      – C# and .NET, Linux, Windows and cloud, C/C++ for embedded systems – plus the products on this page. Managing director:
      {COMPANY.ceo}. E-mail: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>.
    </p>
  </section>

  <ContactBand lang="en" title="Interested in one of our products?" subject="Enquiry about the products" text="Tell us which product you are interested in and what you would like to use it for – we will get back to you personally." />
</Base>

<style>
  .page-hero { padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .page-hero h1 { margin-top: var(--s-3); font-size: var(--fs-3xl); max-width: 22ch; }
  .page-hero .lead { margin-top: var(--s-4); max-width: 62ch; color: var(--ink-2); font-size: var(--fs-lg); }
  .page-hero .eyebrow { margin-top: var(--s-5); }
  .en-note { margin-top: var(--s-4); color: var(--ink-3); font-size: var(--fs-sm); }
  .catalog { display: grid; gap: var(--s-8); scroll-margin-top: 96px; }
  .pline-head { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--s-4); margin-bottom: var(--s-5); padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
  .pline-icon { display: block; width: 52px; height: 52px; }
  .pline-head h2 { font-size: var(--fs-xl); }
  .pline-head p { color: var(--ink-2); font-size: var(--fs-sm); }
  .pgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); padding: 0; margin: 0; list-style: none; }
  .pgrid > li { display: grid; }
  .about-en { margin-top: var(--section-y); max-width: 72ch; }
  .about-en h2 { font-size: var(--fs-2xl); margin-bottom: var(--s-4); }
  .about-en p { color: var(--ink-2); }
  @media (max-width: 1060px) { .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .pgrid { grid-template-columns: minmax(0, 1fr); } }
</style>
