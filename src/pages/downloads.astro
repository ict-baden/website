---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ProductIcon from '../components/product/ProductIcon.astro';
import { products, productUrl } from '../lib/products';
import { isReleased, pageFor } from '../lib/produktseiten';
---
<Base
  title="Downloads"
  description="Kostenlose Software von ICT Baden: die Produkte von Vitrine bis Plakette, der ModbusExplorer für Modbus TCP und der Rechner für die Pulswertigkeit von Energiezählern."
>
  <PageHero eyebrow="Downloads" title="Downloads und Werkzeuge" crumbs={[{ label: 'Downloads' }]}>
    <div class="terms">
      <p>Die hier zur Verfügung gestellten Programme sind kostenfrei.</p>
      <p>Sie sind zur Verwendung „wie sie ist“ gedacht.</p>
      <p>Es wird keine Garantie für die Funktion gegeben.</p>
    </div>
  </PageHero>

  <section class="container dl-products" id="produkte" aria-labelledby="dl-produkte">
    <h2 id="dl-produkte">Software-Produkte</h2>
    <p class="dl-products-lead">Alle Produkte sind kostenlos unter der MIT-Lizenz. Downloads und Quellcode werden mit der Veröffentlichung des jeweiligen Produkts hier verlinkt.</p>
    <ul class="dl-plist" role="list">
      {products.map((p) => {
        const page = pageFor(p);
        return (
          <li class="dl-pitem">
            <ProductIcon product={p} size={40} uid="-dl" />
            <a class="dl-pname" href={productUrl(p)}><strong>{p.name}</strong><span>{p.kind}</span></a>
            <StatusBadge product={p} />
            {page.download.public && page.download.url ? (
              <a class="btn btn--sm" href={page.download.url} rel="noopener"><Icon name="download" /> Download</a>
            ) : (
              <span class="dl-pnote">{isReleased(p) ? 'Download folgt' : 'noch nicht veröffentlicht'}</span>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <div class="container dl-grid">
    <section class="dl reveal" id="modbus" aria-labelledby="dl-modbus">
      <p class="dl-cat">Modbus</p>
      <div class="dl-head">
        <span class="dl-icon"><Icon name="protocol" /></span>
        <h2 id="dl-modbus">ModbusExplorer</h2>
      </div>
      <p class="dl-text">Kostenloses Werkzeug für Modbus TCP.</p>
      <a class="btn" href="https://modbus.de/explorer.html" rel="noopener">
        <Icon name="download" /> ModbusExplorer Download
        <span class="visually-hidden">(externe Seite modbus.de)</span>
      </a>
      <p class="dl-note">Download auf modbus.de</p>
    </section>

    <section class="dl reveal" id="tron" aria-labelledby="dl-tron">
      <p class="dl-cat">Windows Tools</p>
      <div class="dl-head">
        <span class="dl-icon"><Icon name="window" /></span>
        <h2 id="dl-tron">TRON</h2>
      </div>
      <p class="dl-text">Diagnose Ausgabe für Windows (32 Bit)</p>
      <p class="dl-unavailable"><Icon name="info" /> Derzeit kein Download verfügbar.</p>
    </section>

    <section class="dl dl--tool reveal" id="werkzeuge" aria-labelledby="dl-puls">
      <p class="dl-cat">Online-Werkzeug</p>
      <div class="dl-head">
        <span class="dl-icon"><Icon name="calculator" /></span>
        <h2 id="dl-puls">Energiezähler | Pulswertigkeit</h2>
      </div>
      <p class="dl-text">Berechnung der Pulswertigkeit aus Wandlerkonstante oder den Daten eines Messwandlerzählers – direkt im Browser.</p>
      <a class="btn btn--secondary" href="/werkzeuge/pulswertigkeit/">Zum Rechner <Icon name="arrow-right" /></a>
    </section>
  </div>
</Base>

<style>
  .dl-products { margin-bottom: var(--s-8); }
  .dl-products h2 { font-size: var(--fs-2xl); }
  .dl-products-lead { margin: var(--s-3) 0 var(--s-5); max-width: 70ch; color: var(--ink-2); }
  .dl-plist { display: grid; gap: 0; padding: 0; margin: 0; list-style: none; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
  .dl-pitem { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--line); background: var(--bg-elev); }
  .dl-pitem:last-child { border-bottom: 0; }
  .dl-pitem :global(.picon) { --picon-size: 40px; }
  .dl-pname { display: grid; color: var(--ink); text-decoration: none; }
  .dl-pname span { color: var(--ink-3); font-size: var(--fs-sm); }
  .dl-pname:hover strong { text-decoration: underline; text-decoration-color: var(--link-line); }
  .dl-pnote { color: var(--ink-3); font-size: var(--fs-sm); white-space: nowrap; }
  @media (max-width: 640px) {
    .dl-pitem { grid-template-columns: auto minmax(0, 1fr); row-gap: var(--s-2); }
    .dl-pitem > :global(.badge), .dl-pnote, .dl-pitem > .btn { grid-column: 2; justify-self: start; }
  }
  .terms { display: grid; gap: 0.15rem; margin-top: var(--s-5); color: var(--ink-2); font-size: var(--fs-lg); }
  .dl-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  .dl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 110px;
  }
  .dl-cat { color: var(--ink-3); font-size: var(--fs-xs); font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; }
  .dl-head { display: flex; align-items: center; gap: var(--s-3); }
  .dl-icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--brand-yellow); color: #111111; }
  .dl h2 { font-size: var(--fs-xl); }
  .dl-text { color: var(--ink-2); margin-bottom: var(--s-3); }
  .dl .btn { margin-top: auto; }
  .dl-note { color: var(--ink-3); font-size: var(--fs-xs); }
  .dl-unavailable { display: inline-flex; align-items: center; gap: 0.5em; margin-top: auto; padding: 0.6rem 0.9rem; border-radius: var(--r-sm); background: var(--st-plan-bg); color: var(--ink-2); font-size: var(--fs-sm); }
  .dl-unavailable :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .dl--tool { background: linear-gradient(160deg, var(--bg-elev), var(--highlight-soft)); }
  @media (max-width: 980px) { .dl-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
