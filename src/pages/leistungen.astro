---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Parts from '../components/Parts.astro';
import ContactBand from '../components/ContactBand.astro';
import { PORTFOLIO_INTRO, SERVICES, TOPICS } from '../data/portfolio';
---
<Base
  title="Leistungen & Portfolio"
  description="Beratung und Softwareentwicklung im Auftrag: C# und .NET, Linux, Windows und Cloud, C/C++ für Embedded – dazu Erfahrung mit Industrieprotokollen, Steuerungstechnik, IoT, Telekommunikation und Energiemanagement."
>
  <PageHero
    eyebrow="Leistungen"
    title="Beratung und Softwareentwicklung im Auftrag"
    lead={`${SERVICES.claim}. ${SERVICES.intro}`}
    crumbs={[{ label: 'Leistungen' }]}
  />

  <section class="container" aria-labelledby="sw-titel">
    <h2 id="sw-titel" class="visually-hidden">Softwareentwicklung im Auftrag</h2>
    <div class="svc">
      {SERVICES.points.map((s) => (
        <article class="svc-item reveal">
          <Icon name={s.icon} class="svc-icon" />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="pf-titel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Portfolio</p>
        <h2 id="pf-titel">Themengebiete</h2>
        <p class="lead">{PORTFOLIO_INTRO.join(' ')}</p>
      </div>
      <ol class="pf">
        {TOPICS.map((t, i) => (
          <li class="pf-item reveal">
            <div class="pf-side">
              <span class="pf-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="pf-icon"><Icon name={t.icon} /></span>
            </div>
            <div>
              <h3>{t.title}</h3>
              <ul>
                {t.items.map((parts) => <li><Parts parts={parts} /></li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container" aria-labelledby="prod-hint">
    <div class="hint reveal">
      <div>
        <h2 id="prod-hint">Eigene Software-Produkte</h2>
        <p>Neben der Entwicklung im Auftrag entstehen eigene Werkzeuge und Server-Anwendungen für Industrie, Labor und IT.</p>
      </div>
      <a class="btn" href="/produkte/">Zu den Produkten <Icon name="arrow-right" /></a>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .svc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  .svc-item { padding: var(--s-6); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--bg-elev); box-shadow: var(--shadow-sm); }
  .svc-item :global(.svc-icon) { width: 48px; height: 48px; padding: 11px; margin-bottom: var(--s-5); border-radius: 14px; background: var(--highlight); }
  .svc-item h3 { font-size: var(--fs-lg); }
  .svc-item p { margin-top: var(--s-2); color: var(--ink-2); }

  .pf { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-7); padding: 0; margin: 0; list-style: none; }
  .pf-item { display: grid; grid-template-columns: 72px 1fr; gap: var(--s-4); padding: var(--s-6) 0; border-top: 1px solid var(--line); }
  .pf-side { display: grid; gap: var(--s-3); align-content: start; }
  .pf-n { font-family: var(--font-display); font-weight: 700; color: var(--ink-3); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
  .pf-icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-elev); color: var(--accent); }
  .pf h3 { font-size: var(--fs-xl); margin-bottom: var(--s-3); }
  .pf ul { display: grid; gap: 0.5rem; padding: 0; margin: 0; list-style: none; color: var(--ink-2); }
  .pf ul li { position: relative; padding-left: 1.1rem; }
  .pf ul li::before { content: ''; position: absolute; left: 0; top: 0.68em; width: 6px; height: 6px; border-radius: 1.5px; background: var(--brand-yellow); box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 15%, transparent); }

  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--bg-inverse);
    color: var(--ink-inverse);
  }
  .hint h2 { color: var(--ink-inverse); font-size: var(--fs-xl); }
  .hint p { margin-top: var(--s-2); color: var(--ink-inverse-2); max-width: 60ch; }
  .hint .btn { --btn-bg: #ffe14a; --btn-ink: #14161b; --btn-bg-hover: #fff08a; --btn-ink-hover: #14161b; }
  .hint :focus-visible { outline-color: #ffe14a; }

  @media (max-width: 980px) { .svc { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) { .pf { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .pf-item { grid-template-columns: minmax(0, 1fr); } .pf-side { grid-auto-flow: column; justify-content: start; align-items: center; } }
</style>
