---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ThemeImage from '../components/ThemeImage.astro';
import Parts from '../components/Parts.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ProductIcon from '../components/product/ProductIcon.astro';
import ContactBand from '../components/ContactBand.astro';
import { productGlyph } from '../lib/art';
import { featured, linien, products, productsOfLine, productUrl, statusCounts, lineAnchor, colorClasses, STATUS_LABEL, STATUS_ORDER, plural } from '../lib/products';
import { SERVICES, TOPICS } from '../data/portfolio';
import { COMPANY, SITE_URL, mailto } from '../config';

const bySlug = (s: string) => products.find((p) => p.slug === s);
const heroBack = bySlug('zutritt');
const heroMid = bySlug('vitrine');
const heroFront = bySlug('lupe');
const shot = (p: typeof heroBack, name: string) => p?.media.screenshots.find((s) => s.name === name);
const sBack = shot(heroBack, 'folders');
const sMid = shot(heroMid, 'lock');
const sFront = shot(heroFront, 'result');

const total = statusCounts(products);
const ready = products.filter((p) => p.statusKey === 'verfuegbar' || p.statusKey === 'vorabversion');
const moreReady = ready.filter((p) => !featured.includes(p));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY.name,
  url: SITE_URL + '/',
  logo: SITE_URL + '/brand/icon-512.png',
  email: COMPANY.email,
  telephone: COMPANY.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.street,
    postalCode: COMPANY.zip,
    addressLocality: COMPANY.city,
    addressCountry: 'DE',
  },
};
---
<Base
  title="ICT Baden – Getting Things Done"
  bareTitle
  description="ICT Baden GmbH aus Karlsruhe-Durlach: Beratung und Softwareentwicklung im Auftrag – und eigene Software-Produkte für Industrie, Labor und IT."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Softwareentwicklung · Karlsruhe-Durlach</p>
        <h1 class="hero-title">Getting Things<br /><span class="hl">Done.</span></h1>
        <p class="hero-lead">
          Wir bieten Beratung und Softwareentwicklung im Auftrag – und entwickeln eigene
          Software-Produkte für Industrie, Labor und&nbsp;IT.
        </p>
        <div class="btn-row hero-cta">
          <a class="btn" href="/produkte/">Produkte ansehen <Icon name="arrow-right" /></a>
          <a class="btn btn--secondary" href="/leistungen/">Leistungen</a>
        </div>
        <ul class="hero-points" aria-label="Schwerpunkte">
          <li><Icon name="code" />C# · Mono bis .NET 10</li>
          <li><Icon name="layers" />Linux · Windows · Cloud</li>
          <li><Icon name="chip" />C/C++ für Embedded</li>
        </ul>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <div class="stage-glow"></div>
        {sBack && (
          <div class="stage-card stage-back">
            <ThemeImage light={sBack.light} dark={sBack.dark} alt="" sizes="(min-width: 1100px) 560px, 80vw" />
          </div>
        )}
        {sMid && (
          <div class="stage-card stage-mid">
            <ThemeImage light={sMid.light} dark={sMid.dark} alt="" sizes="(min-width: 1100px) 520px, 76vw" />
          </div>
        )}
        {sFront && (
          <div class="stage-card stage-front">
            <ThemeImage light={sFront.light} dark={sFront.dark} alt="" sizes="(min-width: 1100px) 300px, 50vw" />
          </div>
        )}
        <div class="stage-chip stage-chip--a">
          {heroMid && <ProductIcon product={heroMid} size={28} />}
          <span><strong>Vitrine</strong> Ansehen, nicht anfassen.</span>
        </div>
        <div class="stage-chip stage-chip--b">
          {heroBack && <ProductIcon product={heroBack} size={28} />}
          <span><strong>Zutritt</strong> Wer darf wohin?</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="section services" aria-labelledby="leistungen-titel">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Leistungen</p>
        <h2 id="leistungen-titel">Beratung und Softwareentwicklung im Auftrag</h2>
        <p class="lead">{SERVICES.intro} Über die Jahre haben sich Erfahrung und Themengebiete angesammelt – von der Steuerung bis in die Cloud.</p>
      </div>

      <div class="service-points">
        {SERVICES.points.map((s, i) => (
          <article class="spoint reveal">
            <span class="spoint-n" aria-hidden="true">0{i + 1}</span>
            <Icon name={s.icon} class="spoint-icon" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>

      <div class="topics-head reveal">
        <h3>Themengebiete</h3>
        <a class="link-arrow" href="/leistungen/">Alle Themen und Links <Icon name="arrow-right" /></a>
      </div>
      <ul class="topics" role="list">
        {TOPICS.map((t) => (
          <li class="topic reveal">
            <div class="topic-head">
              <span class="topic-icon"><Icon name={t.icon} /></span>
              <h4>{t.title}</h4>
            </div>
            <ul>
              {t.items.map((parts) => <li><Parts parts={parts} /></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Produkte -->
  <section class="section products-band" aria-labelledby="produkte-titel">
    <div class="band-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow eyebrow--inv">Eigene Produkte</p>
        <h2 id="produkte-titel">Software-Produkte für Industrie, Labor und&nbsp;IT</h2>
        <p class="lead">
          {plural(products.length, 'Produkt', 'Produkte')} in {linien.length} Produktlinien – von der fertigen Anwendung
          bis zur geplanten Lösung. {total.verfuegbar} sind verfügbar, {total.vorabversion} als Vorabversion.
        </p>
      </div>

      <div class="featured">
        {featured.map((p, i) => {
          const s = p.media.screenshots[0];
          return (
            <article class:list={['feat', ...colorClasses(p), 'reveal', i === 0 && 'feat--wide']}>
              <div class="feat-copy">
                <div class="feat-head">
                  <ProductIcon product={p} size={52} />
                  <div>
                    <h3><a href={productUrl(p)}>{p.name}</a></h3>
                    {p.tagline && <p class="feat-tag">{p.tagline}</p>}
                  </div>
                </div>
                <p class="feat-text">{p.text}</p>
                <div class="feat-meta">
                  <StatusBadge product={p} />
                  <span class="feat-more" aria-hidden="true">Mehr erfahren <Icon name="arrow-right" /></span>
                </div>
              </div>
              {s && (
                <div class="feat-shot">
                  <ThemeImage light={s.light} dark={s.dark} alt="" sizes="(min-width: 1100px) 640px, 92vw" />
                </div>
              )}
            </article>
          );
        })}
      </div>

      {moreReady.length > 0 && (
        <div class="ready reveal">
          <h3 class="ready-title">Außerdem verfügbar oder als Vorabversion</h3>
          <ul class="ready-list">
            {moreReady.map((p) => (
              <li>
                <a href={productUrl(p)} class="ready-item">
                  <ProductIcon product={p} size={36} uid="-r" />
                  <span class="ready-name">{p.name}<span class="ready-kind">{p.kind ?? linien.find((l) => l.id === p.linie)?.name}</span></span>
                  <StatusBadge product={p} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="lines-head reveal">
        <h3>Die Produktlinien</h3>
        <a class="link-arrow link-arrow--inv" href="/produkte/">Alle {products.length} Produkte <Icon name="arrow-right" /></a>
      </div>
      <ul class="lines" role="list">
        {linien.map((l) => {
          const list = productsOfLine(l.id);
          const c = statusCounts(list);
          return (
            <li class="reveal">
              <a class:list={['line', `art--${l.id}`]} href={lineAnchor(l.id)}>
                <span class="line-icon" set:html={productGlyph(`linie-${l.id}`, l.id, '-home')} />
                <span class="line-name">{l.name}</span>
                <span class="line-text">{l.text}</span>
                <span class="line-count">
                  <span>{plural(list.length, 'Produkt', 'Produkte')}</span>
                  <span class="dist" aria-hidden="true">
                    {STATUS_ORDER.filter((k) => c[k] > 0).map((k) => <span class:list={['dist-seg', `dist-seg--${k}`, `g${Math.min(c[k], 12)}`]}></span>)}
                  </span>
                  <span class="visually-hidden">: {STATUS_ORDER.filter((k) => c[k] > 0).map((k) => `${c[k]} ${STATUS_LABEL[k]}`).join(', ')}</span>
                </span>
              </a>
            </li>
          );
        })}
        <li class="reveal">
          <a class="line line--all" href="/produkte/">
            <span class="line-all-n">{products.length}</span>
            <span class="line-name">Alle Produkte</span>
            <span class="line-text">Übersicht mit Filter nach Produktlinie und Status</span>
            <span class="line-count line-go">Zur Übersicht <Icon name="arrow-right" /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Über uns -->
  <section class="section about" aria-labelledby="ueber-titel">
    <div class="container about-grid">
      <div class="about-quote reveal">
        <p class="eyebrow">Über uns</p>
        <h2 id="ueber-titel" class="visually-hidden">Über uns</h2>
        <blockquote>
          <p>„Wir“, das bin hauptsächlich ich, Frank Pfattheicher.</p>
        </blockquote>
        <p class="about-text">
          Um Projekte realisieren zu können, bei denen „ein Mann“ nicht ausreicht, stehen mir erfahrene Partner zur Seite.
          Wir sind Dienstleister und Partner für alle, die individuelle Software-Lösungen brauchen.
        </p>
        <a class="link-arrow" href="/ueber-uns/">Mehr über uns <Icon name="arrow-right" /></a>
      </div>
      <ul class="about-facts" role="list">
        <li class="reveal">
          <Icon name="pin" />
          <div><strong>Karlsruhe-Durlach</strong><span>Seit Jahren auch mit Großfirmen ausschließlich remote</span></div>
        </li>
        <li class="reveal">
          <Icon name="user" />
          <div><strong>.NET UserGroup Karlsruhe</strong><span>2004 mitgegründet und lange Jahre geleitet</span></div>
        </li>
        <li class="reveal">
          <Icon name="layers" />
          <div><strong>.NET Open Space Süd</strong><span>Mitarbeit am Austausch über die Grenzen von Karlsruhe hinaus</span></div>
        </li>
        <li class="reveal">
          <Icon name="briefcase" />
          <div><strong>VKSI</strong><span>Mitglied im Verein der Karlsruher Software-Ingenieure</span></div>
        </li>
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: clip; padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(3.5rem, 2rem + 6vw, 7rem); }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40rem 26rem at 82% 18%, color-mix(in srgb, var(--brand-yellow) 34%, transparent), transparent 70%),
      radial-gradient(30rem 22rem at 98% 70%, color-mix(in srgb, var(--brand-red) 12%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 30%, #000 30%, transparent 85%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }
  .hero-eyebrow { margin-bottom: var(--s-5); }
  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 820;
    font-stretch: 108%;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero-title .hl {
    position: relative;
    display: inline-block;
    z-index: 0;
  }
  .hero-title .hl::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -0.04em;
    right: -0.06em;
    bottom: 0.08em;
    height: 0.34em;
    border-radius: 0.08em;
    background: var(--brand-yellow);
    transform-origin: left center;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .hero-title .hl { color: var(--brand-yellow); }
    :global(:root:not([data-theme="light"])) .hero-title .hl::after { display: none; }
  }
  :global(:root[data-theme="dark"]) .hero-title .hl { color: var(--brand-yellow); }
  :global(:root[data-theme="dark"]) .hero-title .hl::after { display: none; }
  .hero-lead { margin-top: var(--s-5); max-width: 34rem; font-size: var(--fs-lg); line-height: 1.55; color: var(--ink-2); }
  .hero-cta { margin-top: var(--s-6); }
  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-6);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 540;
  }
  .hero-points li { display: inline-flex; align-items: center; gap: 0.5em; }
  .hero-points :global(.icon) { width: 1.1rem; height: 1.1rem; color: var(--accent); }

  .hero-stage { position: relative; aspect-ratio: 1 / 0.86; }
  .stage-glow {
    position: absolute;
    inset: 8% 4% 4% 10%;
    border-radius: 40px;
    background: linear-gradient(135deg, var(--ln-explorer-1), var(--ln-labor-2));
    filter: blur(60px);
    opacity: 0.28;
  }
  .stage-card {
    position: absolute;
    overflow: hidden;
    border-radius: 14px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .stage-card :global(img) { width: 100%; height: auto; }
  .stage-back { width: 78%; right: 0; top: 0; transform: rotate(1.5deg); }
  .stage-mid { width: 74%; left: 0; top: 34%; transform: rotate(-1.2deg); }
  .stage-front { width: 44%; right: 4%; bottom: 2%; border-radius: 12px; }
  .stage-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md), 0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .stage-chip strong { color: var(--ink); margin-right: 0.35em; }
  .stage-chip :global(.picon) { --picon-size: 28px; filter: none; }
  .stage-chip--a { left: 4%; top: 25%; }
  .stage-chip--b { right: 2%; top: -4%; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 900ms var(--ease-out) both; }
    .hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .hero-copy > :nth-child(3) { animation-delay: 160ms; }
    .hero-copy > :nth-child(4) { animation-delay: 240ms; }
    .hero-copy > :nth-child(5) { animation-delay: 320ms; }
    .hero-title .hl::after { animation: mark 900ms 450ms var(--ease-out) both; }
    .stage-back { animation: in-back 1100ms 120ms var(--ease-out) both; }
    .stage-mid { animation: in-mid 1100ms 260ms var(--ease-out) both; }
    .stage-front { animation: in-front 1000ms 480ms var(--ease-out) both; }
    .stage-chip { animation: rise 800ms 700ms var(--ease-out) both; }
    .stage-chip--b { animation-delay: 820ms; }
    .hero-stage:hover .stage-back { transform: rotate(2.2deg) translate(6px, -6px); }
    .hero-stage:hover .stage-mid { transform: rotate(-1.8deg) translate(-6px, 4px); }
    .stage-card { transition: transform 900ms var(--ease-out); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes mark { from { transform: scaleX(0); } }
  @keyframes in-back { from { opacity: 0; transform: translate(30px, -10px) rotate(4deg); } }
  @keyframes in-mid { from { opacity: 0; transform: translate(-30px, 20px) rotate(-4deg); } }
  @keyframes in-front { from { opacity: 0; transform: translateY(30px) scale(0.96); } }

  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-stage { max-width: 640px; width: 100%; margin-inline: auto; margin-top: var(--s-4); }
  }
  @media (max-width: 520px) {
    .stage-chip--a { left: 0; top: 30%; }
    .stage-chip--b { display: none; }
    .stage-chip { font-size: 0.75rem; }
  }

  /* Leistungen */
  .service-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  .spoint {
    position: relative;
    padding: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }
  .spoint-n { position: absolute; top: 1.4rem; right: 1.6rem; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .spoint :global(.spoint-icon) {
    width: 48px; height: 48px; padding: 11px;
    border-radius: 14px;
    background: var(--highlight);
    color: var(--ink);
    margin-bottom: var(--s-5);
  }
  .spoint h3 { font-size: var(--fs-lg); }
  .spoint p { margin-top: var(--s-2); color: var(--ink-2); }

  .topics-head, .lines-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin: var(--s-8) 0 var(--s-5); }
  .topics-head h3, .lines-head h3 { font-size: var(--fs-xl); }
  .topics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; padding: 0; margin: 0; list-style: none; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: var(--line); }
  .topic { padding: var(--s-5) clamp(1.1rem, 0.8rem + 1vw, 1.75rem) var(--s-6); background: var(--bg-elev); }
  .topic-head { display: flex; align-items: center; gap: var(--s-3); margin-bottom: var(--s-3); }
  .topic-icon { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line); color: var(--accent); flex: none; }
  .topic-icon :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .topic h4 { font-size: 1.05rem; font-stretch: 100%; }
  .topic ul { display: grid; gap: 0.35rem; padding: 0; margin: 0; list-style: none; color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.5; }
  .topic li li, .topic ul li { position: relative; padding-left: 1rem; }
  .topic ul li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; border-radius: 1px; background: var(--line-strong); }

  @media (max-width: 980px) {
    .service-points { grid-template-columns: 1fr; }
    .topics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .topics { grid-template-columns: 1fr; }
  }

  /* Produkte (dunkles Band) */
  .products-band {
    position: relative;
    isolation: isolate;
    color: var(--ink-inverse);
    background: var(--bg-inverse);
    --ink: var(--ink-inverse);
    --ink-2: var(--ink-inverse-2);
    --ink-3: #9aa1ad;
    --line: rgb(255 255 255 / 0.1);
    --line-strong: rgb(255 255 255 / 0.18);
    --accent: #ffe14a;
    --accent-hover: #fff08a;
    --focus: #ffe14a;
    --bg-elev: #171b23;
    --st-ok-ink: #7ee2ad; --st-ok-bg: rgb(126 226 173 / 0.12);
    --st-beta-ink: #ffd866; --st-beta-bg: rgb(255 216 102 / 0.13);
    --st-dev-ink: #9bbaff; --st-dev-bg: rgb(155 186 255 / 0.13);
    --st-plan-ink: #b6bcc7; --st-plan-bg: rgb(255 255 255 / 0.05); --st-plan-dot: #6f7683;
    color-scheme: dark;
  }
  .products-band h2, .products-band h3 { color: var(--ink); }
  .band-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50rem 30rem at 85% -10%, rgb(255 230 0 / 0.14), transparent 70%),
      radial-gradient(40rem 30rem at -10% 110%, rgb(94 176 255 / 0.12), transparent 70%);
  }
  .eyebrow--inv { color: var(--ink-2); }

  .featured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
  .feat {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(255 255 255 / 0.18), transparent 60%),
      linear-gradient(140deg, var(--l1), var(--l2));
    color: #fff;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    transition: transform 500ms var(--ease-out);
  }
  .feat:hover { transform: translateY(-4px); }
  .feat--wide { grid-column: 1 / -1; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); grid-template-rows: none; }
  .feat-copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--s-4); padding: clamp(1.4rem, 1rem + 2vw, 2.75rem); }
  .feat-head { display: flex; align-items: center; gap: var(--s-4); }
  .feat-head :global(.picon) { --picon-size: 52px; }
  .feat h3 { font-size: var(--fs-2xl); color: #fff; }
  .feat h3 a { color: inherit; text-decoration: none; }
  .feat h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .feat:has(h3 a:focus-visible) { outline: 3px solid #ffe14a; outline-offset: 4px; }
  .feat h3 a:focus-visible { outline: none; }
