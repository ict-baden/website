---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ThemeImage from '../../components/ThemeImage.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ContactBand from '../../components/ContactBand.astro';
import ProductIcon from '../../components/product/ProductIcon.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import Blocks from '../../components/product/Blocks.astro';
import { coverArt } from '../../lib/art';
import { colorClasses, lineAnchor, lineById, products, productsOfLine, STATUS_HELP, STATUS_ORDER, type Product } from '../../lib/products';
import { mailto } from '../../config';
import { existsSync } from 'node:fs';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product: p } = Astro.props;
const line = lineById(p.linie);
const m = p.media;
const hero = m.screenshots[0];
// Bühne oben: Animation, sonst erstes Bildschirmfoto, sonst erzeugtes Motiv
const gallery = m.demo ? m.screenshots : m.screenshots.slice(1);
const planned = p.statusKey === 'geplant';
const related = productsOfLine(p.linie)
  .filter((x) => x.slug !== p.slug)
  .sort((a, b) => STATUS_ORDER.indexOf(a.statusKey) - STATUS_ORDER.indexOf(b.statusKey) || a.nr - b.nr)
  .slice(0, 3);
const hasSections = Boolean(p.sections.problem || p.sections.ersetzt || p.sections.umfang);
const hasMain = hasSections || m.screenshots.length === 0;
const subject = `Anfrage zu ${p.name}`;
const title = p.kind ? `${p.name} – ${p.kind}` : p.name;
const og = existsSync(`public/og/produkte/${p.slug}.jpg`) ? `/og/produkte/${p.slug}.jpg` : undefined;
---
<Base title={title} description={p.text} ogType="article" ogImage={og}>
  <section class:list={['dhero', ...colorClasses(p)]}>
    <div class="dhero-bg" aria-hidden="true"></div>
    <div class="container dhero-grid">
      <div class="dhero-copy">
        <nav aria-label="Brotkrumen">
          <ol class="crumbs">
            <li><a href="/">Start</a></li>
            <li><a href="/produkte/">Produkte</a></li>
            <li><a href={lineAnchor(line.id)}>{line.name}</a></li>
            <li><span aria-current="page">{p.name}</span></li>
          </ol>
        </nav>
        <div class:list={['dhead', p.name.length > 13 && 'dhead--long']}>
          <ProductIcon product={p} size={76} uid="-hero" class="dicon" />
          <div>
            <h1>{p.name}</h1>
            {p.kind && <p class="dkind">{p.kind}</p>}
          </div>
        </div>
        {p.tagline && <p class="dtag">{p.tagline}</p>}
        <p class="dlead">{p.text}</p>
        <div class="dmeta">
          <StatusBadge product={p} />
          <a class="tag" href={lineAnchor(line.id)}>{line.name}</a>
        </div>
        {p.highlights.length > 0 && (
          <ul class="tag-list dhl" aria-label="Schwerpunkte">
            {p.highlights.map((h) => <li class="hl-chip">{h}</li>)}
          </ul>
        )}
        <div class="btn-row dcta">
          <a class="btn" href={mailto(subject)}><Icon name="mail" /> {planned ? 'Interesse melden' : 'Anfrage senden'}</a>
          <a class="btn btn--secondary" href={lineAnchor(line.id)}>Mehr aus „{line.name}“</a>
        </div>
      </div>

      <div class="dhero-visual">
        {m.demo ? (
          <figure class="dvis dvis--shot">
            <div class="dvis-frame dvis-frame--demo">
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset={m.demo.still} />
                <img src={m.demo.src} width={m.demo.width} height={m.demo.height} alt={m.demo.alt} fetchpriority="high" />
              </picture>
            </div>
            {m.demo.caption && <figcaption>{m.demo.caption}</figcaption>}
          </figure>
        ) : hero ? (
          <figure class="dvis dvis--shot">
            <div class="dvis-frame">
              <ThemeImage light={hero.light} dark={hero.dark} alt={hero.alt} sizes="(min-width: 1100px) 620px, 92vw" eager />
            </div>
            <figcaption><strong>{hero.title}</strong> {hero.caption}</figcaption>
          </figure>
        ) : (
          <div class="dvis dvis--art" set:html={coverArt(p.slug, p.linie, '-hero')} />
        )}
      </div>
    </div>
  </section>

  <div class:list={["container", "dbody", !hasMain && "dbody--solo"]}>
    {hasMain && <div class="dmain">
      {p.sections.problem && (
        <section class="dsec reveal" aria-labelledby="s-problem">
          <h2 id="s-problem"><span class="dsec-n" aria-hidden="true">01</span> Ausgangslage</h2>
          <Blocks blocks={p.sections.problem} />
        </section>
      )}
      {p.sections.ersetzt && (
        <section class="dsec reveal" aria-labelledby="s-ersetzt">
          <h2 id="s-ersetzt"><span class="dsec-n" aria-hidden="true">{p.sections.problem ? '02' : '01'}</span> Was es ersetzt</h2>
          <Blocks blocks={p.sections.ersetzt} />
        </section>
      )}
      {p.sections.umfang && (
        <section class="dsec reveal" aria-labelledby="s-umfang">
          <h2 id="s-umfang">
            <span class="dsec-n" aria-hidden="true">{String(1 + (p.sections.problem ? 1 : 0) + (p.sections.ersetzt ? 1 : 0)).padStart(2, '0')}</span>
            {planned ? 'Geplanter Umfang der ersten Version' : 'Umfang der ersten Version'}
          </h2>
          <Blocks blocks={p.sections.umfang} checks />
        </section>
      )}
      {!hasSections && m.screenshots.length === 0 && (
        <section class="dsec dsec--note">
          <h2>Mehr erfahren</h2>
          <p class="dnote">Weitere Informationen zu {p.name} erhalten Sie gern auf Anfrage – per E-Mail oder Telefon.</p>
        </section>
      )}

    </div>}

    <aside class="daside" aria-label={`${p.name} auf einen Blick`}>
      <div class="card card--pad dfacts">
        <h2 class="daside-title">Auf einen Blick</h2>
        <dl>
          <div><dt>Produktlinie</dt><dd><a href={lineAnchor(line.id)}>{line.name}</a></dd></div>
          <div><dt>Status</dt><dd>{p.statusLabel}<span class="dd-help">{STATUS_HELP[p.statusKey]}</span></dd></div>
          {p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
      </div>
      <div class="card card--pad dask">
        <h2 class="daside-title">{planned ? 'Bedarf an dieser Lösung?' : 'Interesse?'}</h2>
        <p>{planned
          ? `${p.name} ist geplant. Erzählen Sie uns von Ihrem Anwendungsfall – das hilft bei der Ausgestaltung.`
          : `Fragen zu ${p.name}, Einsatz oder Support? Schreiben Sie uns.`}</p>
        <a class="btn" href={mailto(subject)}><Icon name="mail" /> E-Mail schreiben</a>
      </div>
    </aside>
  </div>

  {gallery.length > 0 && (
    <section class="container dgallery" aria-labelledby="s-bilder">
      <div class="dgallery-head">
        <h2 id="s-bilder">So sieht {p.name} aus</h2>
        {m.galleryNote && <p class="muted">{m.galleryNote}</p>}
      </div>
      <ul class="shots" role="list">
        {gallery.map((s) => (
          <li class="reveal">
            <figure>
              <a class="shot shot-link" href={s.light.src} aria-label={`${s.title}: Bild in voller Größe öffnen`}>
                <ThemeImage light={s.light} dark={s.dark} alt={s.alt} sizes="(min-width: 1100px) 600px, (min-width: 720px) 46vw, 92vw" />
              </a>
              <figcaption><strong>{s.title}</strong>{s.caption && <span>{s.caption}</span>}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="container drelated" aria-labelledby="s-related">
      <div class="drelated-head">
        <h2 id="s-related">Mehr aus „{line.name}“</h2>
        <a class="link-arrow" href={lineAnchor(line.id)}>Alle {productsOfLine(line.id).length} Produkte der Linie <Icon name="arrow-right" /></a>
      </div>
      <ul class="rgrid" role="list">
        {related.map((r) => <li><ProductCard product={r} uid="-rel" /></li>)}
      </ul>
    </section>
  )}

  <ContactBand title={`Interesse an ${p.name}?`} subject={subject} text="Schreiben Sie uns, wofür Sie das Produkt einsetzen möchten – wir melden uns persönlich." />
</Base>

<style>
  .dhero { position: relative; overflow: clip; padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 5.5rem); }
  .dhero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46rem 30rem at 85% 10%, color-mix(in srgb, var(--l1) 30%, transparent), transparent 70%),
      radial-gradient(30rem 24rem at 100% 90%, color-mix(in srgb, var(--l2) 18%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 90% 100% at 70% 20%, #000 30%, transparent 80%);
  }
  .dhero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .dhead { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-2); }
  .dhead :global(.dicon) { --picon-size: 76px; }
  .dhead > div { min-width: 0; }
  .dhead h1 { font-size: var(--fs-3xl); font-stretch: 106%; letter-spacing: -0.03em; hyphens: auto; overflow-wrap: break-word; }
  .dhead--long h1 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.1rem); }
  .dkind { margin-top: 0.3rem; color: var(--ink-3); font-size: var(--fs-lg); font-weight: 560; }
  .dtag { margin-top: var(--s-5); font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; font-stretch: 104%; letter-spacing: -0.015em; color: var(--ink); }
  .dlead { margin-top: var(--s-4); max-width: 56ch; color: var(--ink-2); font-size: var(--fs-lg); line-height: 1.55; }
  .dmeta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); margin-top: var(--s-5); }
  .dhl { margin-top: var(--s-4); }
  .hl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.85em 0.35em 0.7em;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg-elev);
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .hl-chip::before { content: ""; width: 0.45em; height: 0.45em; border-radius: 2px; background: linear-gradient(135deg, var(--l1), var(--l2)); }
  .dcta { margin-top: var(--s-6); }

  .dvis { position: relative; }
  .dvis-frame { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .dvis-frame {
    position: relative;
    padding: clamp(14px, 2.5vw, 28px) 0 0 clamp(14px, 2.5vw, 28px);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.32), transparent 55%),
      linear-gradient(135deg, var(--l1), var(--l2));
  }
  .dvis-frame--demo { padding: clamp(10px, 1.6vw, 18px); }
  .dvis-frame--demo img { width: 100%; height: auto; border-radius: 10px; }
  .dvis-frame :global(img) { width: 100%; height: auto; border-radius: 10px 0 0 0; box-shadow: 0 -8px 30px -8px rgb(0 0 0 / 0.35); }
  .dvis--shot figcaption { margin-top: var(--s-3); color: var(--ink-3); font-size: var(--fs-sm); }
  .dvis--shot figcaption strong { color: var(--ink); margin-right: 0.3em; }
  .dvis--art { aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-lg); box-shadow: var(--shadow-lg); background: linear-gradient(135deg, var(--l1), var(--l2)); }
  .dvis--art :global(.art) { width: 100%; height: 100%; }

  .dbody { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .dmain { display: grid; gap: var(--s-8); }
  .dbody--solo { grid-template-columns: minmax(0, 1fr); }
  .dbody--solo .daside { position: static; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; }
  .dbody--solo .dfacts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-6); }
  .dsec h2 { display: flex; align-items: baseline; gap: 0.6em; margin-bottom: var(--s-4); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .dsec-n { font-size: var(--fs-sm); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: 0; }
  .dnote { color: var(--ink-2); }

  .daside { position: sticky; top: 96px; display: grid; gap: var(--s-4); }
  .daside-title { margin-bottom: var(--s-4); font-family: var(--font-sans); font-size: var(--fs-xs); font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .dfacts dl { display: grid; gap: var(--s-4); margin: 0; }
  .dfacts dt { color: var(--ink-3); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.02em; }
  .dfacts dd { margin: 0.15rem 0 0; color: var(--ink); font-size: var(--fs-sm); font-weight: 540; }
  .dd-help { display: block; color: var(--ink-3); font-weight: 450; }
  .dask p { color: var(--ink-2); font-size: var(--fs-sm); margin-bottom: var(--s-4); }
  .dask .btn { width: 100%; }

  .dgallery { margin-top: var(--section-y); }
  .dgallery-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-6); }
  .dgallery-head h2 { font-size: var(--fs-2xl); }
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-6); padding: 0; margin: 0; list-style: none; }
  .shots figure { margin: 0; }
  .shot-link { display: block; transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out); }
  .shot-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .shots figcaption { display: grid; gap: 0.2rem; margin-top: var(--s-4); }
  .shots figcaption strong { color: var(--ink); font-size: var(--fs-lg); font-family: var(--font-display); font-weight: 700; font-stretch: 104%; letter-spacing: -0.01em; }
  .shots figcaption span { color: var(--ink-2); font-size: var(--fs-sm); max-width: 60ch; }

  .drelated { margin-top: var(--section-y); }
  .drelated-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-6); }
  .drelated-head h2 { font-size: var(--fs-2xl); }
  .rgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); padding: 0; margin: 0; list-style: none; }
  .rgrid > li { display: grid; }

  @media (max-width: 1060px) {
    .dbody { grid-template-columns: minmax(0, 1fr); }
    .daside { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .dhero-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .shots, .rgrid, .daside, .dbody--solo .daside, .dbody--solo .dfacts dl { grid-template-columns: minmax(0, 1fr); }
    .dhead { gap: var(--s-4); }
    .dhead :global(.dicon) { --picon-size: 60px; }
  }
</style>
