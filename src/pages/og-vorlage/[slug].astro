---
// Nur für scripts/make-brand-assets.mjs (OG_TEMPLATES=1); im normalen Build entstehen hier keine Seiten.
import OgCard from '../../components/OgCard.astro';
import { products, type Product } from '../../lib/products';

export function getStaticPaths() {
  if (process.env.OG_TEMPLATES !== '1') return [];
  return [{ params: { slug: 'ict-baden' }, props: { product: undefined } }, ...products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }))];
}
interface Props { product?: Product }
const { product } = Astro.props;
---
<OgCard product={product} />
