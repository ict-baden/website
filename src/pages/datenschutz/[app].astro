---
// Datenschutzerklärungen der Apps unter /datenschutz/<slug>/ – die Apps verlinken diese Adressen, Google Play verlangt
// sie für die Android-Apps. Inhalte: src/data/app-datenschutz.ts (nach docs/data-and-privacy.md im jeweiligen Repo).
// Deutsch und Englisch auf einer Seite, weil die Apps weltweit laufen.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { COMPANY } from '../../config';
import apps, { type AppPrivacy } from '../../data/app-datenschutz';
import { pageById } from '../../lib/produktseiten';
import { products } from '../../lib/products';

export function getStaticPaths() {
  return apps.map((a) => ({ params: { app: a.slug }, props: { name: a.name } }));
}

const app = apps.find((a) => a.slug === Astro.params.app) as AppPrivacy;
const { name, pkg, de, en } = app;
const android = app.platform === 'android';
const page = pageById(app.productId);
// Quellcode-Link nur, wenn das Repo öffentlich ist (derselbe Schalter wie auf der Produktseite: download.public)
const repo = page?.download.public ? page.download.source ?? null : null;
const product = products.find((p) => p.id === app.productId);
const productUrl = product ? `/produkte/${product.slug}/` : null;
const productUrlEn = product ? `/en/products/${product.slug}/` : null;
const kindDe = android ? 'Android-App' : 'Software';
---
<Base title={`Datenschutz ${name}`} description={`Datenschutzerklärung der ${kindDe} ${name} von ICT Baden: was gespeichert wird, welche Verbindungen es gibt – privacy policy of ${name}.`}>
  <PageHero eyebrow="Rechtliches" title={`Datenschutz­erklärung ${name}`} crumbs={[{ label: 'Datenschutz', href: '/datenschutz/' }, { label: name }]} narrow />

  <div class="container container--narrow">
    <div class="prose privacy">
      <p class="lang-switch"><a href="#deutsch">Deutsch</a> · <a href="#english">English</a></p>

      <h2 id="deutsch">Datenschutzerklärung für {android ? 'die App' : ''} {name}</h2>
      {android
        ? <p>Gilt für die Android-App {name} (Paket <code>{pkg}</code>), in allen Vertriebswegen (direkt als APK, über ein MDM und – sobald veröffentlicht – über Google Play).</p>
        : <p>Gilt für die Software {name} von ICT Baden in allen Lieferformen (Installationspaket, portable Fassung, Befehlszeile).</p>}

      <h3>Verantwortlich</h3>
      <p>
        {COMPANY.name}<br />{COMPANY.street}<br />{COMPANY.zip} {COMPANY.city}<br />
        E-Mail: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
      </p>

      <h3>Kurz gesagt</h3>
      <p>{de.summary}</p>
      <p>{de.operator}</p>

      <h3>{android ? 'Was auf dem Gerät gespeichert wird' : 'Was auf dem Rechner gespeichert wird'}</h3>
      {android && <p>Nur im privaten Speicher der App, andere Apps können ihn nicht lesen:</p>}
      <ul>{de.stored.map((s) => <li>{s}</li>)}</ul>
      {de.storedNote && <p>{de.storedNote}</p>}

      {de.permissions && (<><h3>Berechtigungen</h3><ul>{de.permissions.map(([p, why]) => <li><strong>{p}:</strong> {why}</li>)}</ul></>)}
      {de.connections && (<><h3>Netzwerkverbindungen</h3><ul>{de.connections.map(([p, why]) => <li><strong>{p}:</strong> {why}</li>)}</ul></>)}

      <h3>Löschen</h3>
      <p>{de.deletion}</p>

      <h3>Ihre Rechte</h3>
      <p>
        Sie haben das Recht auf Auskunft, Berichtigung, Löschung und Einschränkung der Verarbeitung sowie ein Beschwerderecht bei
        einer Aufsichtsbehörde. Fragen richten Sie an die oben genannte Adresse. Allgemeine Angaben zu unserer Website:
        <a href="/datenschutz/">Datenschutzerklärung der Website</a>.
        {productUrl && <> Mehr zum Produkt: <a href={productUrl}>{name}</a>.</>}
        {repo && <> Quellcode: <a href={repo} rel="noopener">GitHub</a>.</>}
      </p>

      <h2 id="english" lang="en">Privacy policy for {android ? 'the app' : ''} {name}</h2>
      <div lang="en">
        {android
          ? <p>Applies to the Android app {name} (package <code>{pkg}</code>) in every form of distribution (APK, via an MDM and – once published – Google Play).</p>
          : <p>Applies to the software {name} by ICT Baden in every form of delivery (installer, portable version, command line).</p>}

        <h3>Controller</h3>
        <p>
          {COMPANY.name}<br />{COMPANY.street}<br />{COMPANY.zip} {COMPANY.city}, Germany<br />
          E-mail: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        </p>

        <h3>In short</h3>
        <p>{en.summary}</p>
        <p>{en.operator}</p>

        <h3>{android ? 'What is stored on the device' : 'What is stored on the computer'}</h3>
        {android && <p>Only in the app's private storage, which other apps cannot read:</p>}
        <ul>{en.stored.map((s) => <li>{s}</li>)}</ul>
        {en.storedNote && <p>{en.storedNote}</p>}

        {en.permissions && (<><h3>Permissions</h3><ul>{en.permissions.map(([p, why]) => <li><strong>{p}:</strong> {why}</li>)}</ul></>)}
        {en.connections && (<><h3>Network connections</h3><ul>{en.connections.map(([p, why]) => <li><strong>{p}:</strong> {why}</li>)}</ul></>)}

        <h3>Deletion</h3>
        <p>{en.deletion}</p>

        <h3>Your rights</h3>
        <p>
          You have the right of access, rectification, erasure and restriction of processing, and the right to lodge a complaint
          with a supervisory authority. Please send questions to the address above.
          {productUrlEn && <> More about the product: <a href={productUrlEn} hreflang="en">{name}</a>.</>}
          {repo && <> Source code: <a href={repo} rel="noopener">GitHub</a>.</>}
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Lange Paketnamen und Adressen brechen auf schmalen Bildschirmen um (320 px ohne seitlichen Überlauf) */
  .prose :global(code), .prose :global(a), .prose :global(td) { overflow-wrap: anywhere; }
  main :global(code) { overflow-wrap: anywhere; }
  main :global(p), main :global(li), main :global(td) { overflow-wrap: break-word; }
  .lang-switch { margin-top: 0 !important; color: var(--ink-3); }
  .privacy h2 { scroll-margin-top: 6rem; }
</style>
