---
// Vorlage für Open-Graph-Bilder (1200 × 630). Wird nur mit OG_TEMPLATES=1 gebaut (scripts/make-brand-assets.mjs).
// Website: das Logo-Feld selbst – Baden-Gelb, roter Schrägbalken rechts, schwarze Schrift.
// Produkte: ICT-Schwarz, Produktsymbol und Bildschirmfoto im Farbpaar des Produkts, Logo unten links.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import '../styles/art.css';
import '../styles/product-colors.css';
import Logo from './Logo.astro';
import marke from '../assets/brand/marke.json';
import { coverArt } from '../lib/art';
import { productIconUrl } from '../lib/product-icons';
import { colorClasses, isPortrait, lineById, nameHtml, type Product } from '../lib/products';

interface Props { product?: Product }
const { product: p } = Astro.props;
const line = p ? lineById(p.linie) : null;
const shot = p?.media.screenshots[0];
const phones = shot && isPortrait(shot) ? p!.media.screenshots.filter(isPortrait).slice(0, 3) : [];
const icon = p ? productIconUrl(p) : null;
---
<!doctype html>
<html lang="de" data-theme="dark" class="og-page">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
  </head>
  <body>
    {p ? (
      <div class:list={['og', 'og--product', colorClasses(p)]}>
        <div class="og-glow"></div>
        {phones.length > 0 ? (
          <div class="og-art og-art--phones">{phones.map((x) => <img src={x.light.src} alt="" />)}</div>
        ) : shot ? (
          <div class="og-art og-art--shot"><img src={shot.light.src} alt="" /></div>
        ) : (
          <div class="og-art" set:html={coverArt(p.slug, p.linie, '-og')} />
        )}
        <div class="og-copy">
          {icon && <img class="og-icon" src={icon} alt="" width="84" height="84" />}
          <p class="og-line">{line?.name}</p>
          <h1 class:list={[p.name.length > 9 && 'og-mid', p.name.length > 13 && 'og-long']} set:html={nameHtml(p.name)} />
          {(p.kind || p.tagline) && <p class="og-sub">{p.kind ?? p.tagline}</p>}
          <p class="og-status"><span class:list={['og-dot', `og-dot--${p.statusKey}`]}></span>{p.statusLabel}</p>
        </div>
        <div class="og-brand"><Logo uid="og" /><span>Softwareentwicklung · Karlsruhe-Durlach</span></div>
      </div>
    ) : (
      <div class="og og--site">
        <span class="og-bar"></span>
        <svg class="og-mark" viewBox="30 30 200 150" role="img" aria-label="ICT Baden">
          <path d={marke.logo.ict} fill="#111111" />
          <path d={marke.logo.baden} fill="#111111" />
        </svg>
        <div class="og-copy og-copy--site">
          <h1>Getting Things<br />Done<span class="dot">.</span></h1>
          <p class="og-sub">Beratung und Softwareentwicklung im Auftrag – und eigene Software-Produkte für Industrie, Labor und IT.</p>
        </div>
        <p class="og-place">Softwareentwicklung · Karlsruhe-Durlach</p>
      </div>
    )}
  </body>
</html>

<style is:global>
  /* nur auf der OG-Vorlage: das Stylesheet wird mit allen Seiten gebündelt */
  .og-page, .og-page body { margin: 0; background: #111111; }
  .og { position: relative; width: 1200px; height: 630px; overflow: hidden; font-family: 'Inter Variable', sans-serif; }
  .og h1 { margin: 0; font-family: 'Archivo Variable', sans-serif; font-weight: 820; font-stretch: 108%; line-height: 0.98; letter-spacing: -0.035em; }

  /* Website */
  .og--site { background: #ffd200; color: #111111; }
  .og-bar { position: absolute; top: 0; bottom: 0; left: 813px; width: 160px; background: #e2001a; transform: skewX(26.565deg); transform-origin: 0 0; }
  .og-mark { position: absolute; left: 64px; top: 52px; width: 200px; height: auto; }
  .og--site .og-copy--site { position: absolute; left: 72px; top: 222px; width: 780px; }
  .og--site h1 { font-size: 96px; color: #111111; }
  .og--site .dot { color: #e2001a; }
  .og--site .og-sub { margin: 22px 0 0; max-width: 780px; color: #2d2c26; font-size: 28px; line-height: 1.3; font-weight: 520; }
  .og-place { position: absolute; left: 72px; bottom: 44px; margin: 0; color: #2d2c26; font-size: 22px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }

  /* Produkte */
  .og--product {
    color: #f4f3ef;
    background: #111111;
  }
  .og-glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(640px 420px at 88% 18%, color-mix(in srgb, var(--l1) 34%, transparent), transparent 70%),
      radial-gradient(520px 380px at 100% 100%, color-mix(in srgb, var(--l2) 26%, transparent), transparent 70%);
  }
  .og-art { position: absolute; right: -40px; top: 64px; width: 600px; height: 375px; border-radius: 32px; overflow: hidden; transform: rotate(-4deg); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7); }
  .og-art .art { filter: none !important; }
  .og-art--shot { padding: 34px 0 0 34px; background: radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.3), transparent 55%), linear-gradient(135deg, var(--l1), var(--l2)); }
  .og-art--shot img { display: block; width: 760px; border-radius: 14px 0 0 0; box-shadow: 0 -10px 40px -10px rgb(0 0 0 / 0.4); }
  .og-art--phones { display: flex; justify-content: center; gap: 22px; padding: 36px 20px 0; background: radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.3), transparent 55%), linear-gradient(135deg, var(--l1), var(--l2)); }
  .og-art--phones img { width: 165px; height: auto; filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.4)); }
  .og-art--phones img:nth-child(2) { margin-top: 30px; }
  .og-art--phones img:nth-child(3) { margin-top: 60px; }
  .og-copy { position: absolute; left: 72px; top: 48px; width: 560px; }
  .og-icon { display: block; width: 84px; height: 84px; margin-bottom: 20px; filter: drop-shadow(0 10px 20px rgb(0 0 0 / 0.4)); }
  .og-line { margin: 0 0 12px; color: #ffd200; font-size: 22px; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  /* Umbruch nur an den Stellen aus nameHtml(); passt ein Teil nicht, verkleinert make-brand-assets.mjs die Schrift */
  .og--product h1 { font-size: 84px; color: #ffffff; overflow-wrap: normal; word-break: normal; hyphens: manual; }
  .og--product h1.og-mid { font-size: 70px; }
  .og--product h1.og-long { font-size: 58px; }
  .og--product .og-sub { margin: 18px 0 0; max-width: 540px; color: #c6c5bf; font-size: 30px; line-height: 1.3; font-weight: 500; }
  .og-status { display: inline-flex; align-items: center; gap: 12px; margin: 24px 0 0; padding: 10px 20px; border-radius: 999px; background: rgb(255 255 255 / 0.1); font-size: 24px; font-weight: 600; }
  .og-dot { width: 14px; height: 14px; border-radius: 50%; background: #75746e; }
  .og-dot--verfuegbar { background: #19a35a; } .og-dot--vorabversion { background: #ffd200; } .og-dot--in-entwicklung { background: #3b6cf6; }
  .og-brand { position: absolute; left: 72px; bottom: 40px; display: flex; align-items: center; gap: 22px; font-size: 22px; font-weight: 550; }
  .og-brand .logo { height: 56px; width: auto; }
  .og-brand span { color: #a3a29c; }
</style>
