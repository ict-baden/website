---
// Vorlage für Open-Graph-Bilder (1200 × 630). Wird nur mit OG_TEMPLATES=1 gebaut (scripts/make-brand-assets.mjs).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import '../styles/art.css';
import Logo from './Logo.astro';
import { coverArt, productGlyph } from '../lib/art';
import { colorClasses, lineById, type Product } from '../lib/products';

interface Props { product?: Product }
const { product: p } = Astro.props;
const line = p ? lineById(p.linie) : null;
const shot = p?.media.screenshots[0];
---
<!doctype html>
<html lang="de" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG</title>
    <link rel="stylesheet" href="/produkt-farben.css" />
  </head>
  <body>
    <div class:list={['og', p && colorClasses(p)]}>
      <div class="og-grid"></div>
      {p ? (
        <>
          {shot
            ? <div class="og-art og-art--shot"><img src={shot.light.src} alt="" /></div>
            : <div class="og-art" set:html={coverArt(p.slug, p.linie, '-og')} />}
          <div class="og-copy">
            <div class="og-icon">
              {p.media.logo ? <img src={p.media.logo} alt="" width="96" height="96" /> : <span set:html={productGlyph(p.slug, p.linie, '-og')} />}
            </div>
            <p class="og-line">{line?.name}</p>
            <h1>{p.name}</h1>
            {(p.tagline || p.kind) && <p class="og-sub">{p.tagline ?? p.kind}</p>}
            <p class="og-status"><span class:list={['dot', `dot--${p.statusKey}`]}></span>{p.statusLabel}</p>
          </div>
        </>
      ) : (
        <div class="og-copy og-copy--site">
          <h1>Getting Things <span class="hl">Done.</span></h1>
          <p class="og-sub">Beratung und Softwareentwicklung im Auftrag – und eigene Software-Produkte für Industrie, Labor und IT.</p>
        </div>
      )}
      <div class="og-brand"><Logo uid="og" /><span>Softwareentwicklung · Karlsruhe-Durlach</span></div>
    </div>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: #0b0d11; }
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    color: #f3f4f6;
    font-family: 'Inter Variable', sans-serif;
    background:
      radial-gradient(700px 420px at 92% 8%, rgb(255 230 0 / 0.22), transparent 70%),
      radial-gradient(600px 400px at 100% 100%, rgb(240 20 10 / 0.12), transparent 70%),
      #0f1116;
  }
  .og-grid {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 60px 60px,
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 60px 60px;
    mask-image: radial-gradient(ellipse 80% 90% at 75% 30%, #000 30%, transparent 80%);
  }
  .og-art { position: absolute; right: -40px; top: 60px; width: 600px; height: 375px; border-radius: 32px; overflow: hidden; transform: rotate(-4deg); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7); }
  .og-art .art { filter: none !important; }
  .og-art--shot { padding: 34px 0 0 34px; background: radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.3), transparent 55%), linear-gradient(135deg, var(--l1), var(--l2)); }
  .og-art--shot img { display: block; width: 760px; border-radius: 14px 0 0 0; box-shadow: 0 -10px 40px -10px rgb(0 0 0 / 0.4); }
  .og-copy { position: absolute; left: 72px; top: 70px; width: 560px; }
  .og-copy--site { width: 900px; top: 120px; }
  .og-icon { width: 96px; height: 96px; margin-bottom: 28px; }
  .og-icon img, .og-icon svg { width: 96px; height: 96px; }
  .og-line { margin: 0 0 10px; color: #9aa1ad; font-size: 24px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .og h1 { margin: 0; font-family: 'Archivo Variable', sans-serif; font-weight: 820; font-stretch: 108%; font-size: 92px; line-height: 0.98; letter-spacing: -0.035em; color: #fff; }
  .og-copy--site h1 { font-size: 112px; }
  .og h1 .hl { color: #ffe600; }
  .og-sub { margin: 22px 0 0; color: #c9ced7; font-size: 32px; line-height: 1.3; font-weight: 500; }
  .og-status { display: inline-flex; align-items: center; gap: 12px; margin: 30px 0 0; padding: 10px 20px; border-radius: 999px; background: rgb(255 255 255 / 0.1); font-size: 24px; font-weight: 600; }
  .dot { width: 14px; height: 14px; border-radius: 50%; background: #6f7683; }
  .dot--verfuegbar { background: #19a35a; } .dot--vorabversion { background: #e3a008; } .dot--in-entwicklung { background: #3b6cf6; }
  .og-brand { position: absolute; left: 72px; bottom: 56px; display: flex; align-items: center; gap: 22px; color: #f3f4f6; font-size: 22px; font-weight: 550; }
  .og-brand .logo { height: 52px; width: auto; }
  .og-brand span { color: #9aa1ad; }
</style>
