---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { COMPANY, NAV, STAGING } from '../config';
import { products } from '../lib/products';
import { pageFor, productUrlFor } from '../lib/produktseiten';

interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const year = new Date().getFullYear();
// Produktspalte in der Sprache der Seite: englische Seiten verlinken die englischen Produktseiten
const productLinks = products.map((p) => ({
  name: p.name,
  href: productUrlFor(p, lang),
  kind: lang === 'en' ? pageFor(p).en.kind ?? p.kind : p.kind,
}));
---
<footer class="site-footer" lang={lang === 'de' ? undefined : 'de'}>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label="ICT Baden – zur Startseite"><Logo uid="f" /></a>
        <p class="footer-claim">Softwareentwicklung</p>
        <address>
          {COMPANY.name}<br />
          {COMPANY.street}<br />
          {COMPANY.zip}&nbsp;{COMPANY.city}
        </address>
        <ul class="footer-contact">
          <li><a href={`mailto:${COMPANY.email}`}><Icon name="mail" />{COMPANY.email}</a></li>
          <li><a class="tel" href={COMPANY.mobileHref}><Icon name="phone" />{COMPANY.mobile}</a></li>
        </ul>
      </div>

      <nav class="footer-col footer-col--site" aria-label="Website">
        <p class="footer-label">Website</p>
        <ul>
          <li><a href="/">Start</a></li>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/en/" hreflang="en" lang="en">English</a></li>
        </ul>
      </nav>

      <nav class="footer-col footer-col--products" aria-label={lang === 'en' ? 'Products' : 'Produkte'} lang={lang === 'en' ? 'en' : undefined}>
        <p class="footer-label">{lang === 'en' ? 'Products' : 'Produkte'}</p>
        <ul>
          {productLinks.map((x) => <li><a href={x.href}><span class="fp-name">{x.name}</span>{x.kind && <span class="fp-kind">{x.kind}</span>}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Werkzeuge und Rechtliches">
        <p class="footer-label">Werkzeuge</p>
        <ul>
          <li><a href="/werkzeuge/pulswertigkeit/">Energiezähler-Pulswertigkeit</a></li>
          <li><a href="/downloads/#modbus">ModbusExplorer</a></li>
        </ul>
        <p class="footer-label mt">Rechtliches</p>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>©{year} {COMPANY.name}</p>
      <p class="footer-note">
        Statische Website ohne Tracking{STAGING && ' · Vorschau, nicht für Suchmaschinen freigegeben'}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    padding-block: var(--s-8) var(--s-6);
    border-top: 1px solid var(--line);
    background: var(--bg-elev-2);
    font-size: var(--fs-sm);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1.6fr 1fr;
    gap: var(--s-7) var(--s-6);
  }
  .footer-logo { display: inline-flex; color: var(--ink); border-radius: 6px; }
  .footer-logo :global(.logo) { height: 64px; width: auto; }
  .footer-claim { margin-top: var(--s-4); font-weight: 650; color: var(--ink); }
  address { margin-top: var(--s-2); font-style: normal; color: var(--ink-2); line-height: 1.6; }
  .footer-contact { display: grid; gap: var(--s-2); margin-top: var(--s-4); padding: 0; list-style: none; }
  .footer-contact a { display: inline-flex; align-items: center; gap: 0.55em; color: var(--ink-2); text-decoration: none; }
  .footer-contact a:hover { color: var(--link-hover); }
  .footer-contact :global(.icon) { width: 1.05rem; height: 1.05rem; color: var(--ink-3); }
  .footer-label {
    margin-bottom: var(--s-3);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .footer-label.mt { margin-top: var(--s-6); }
  .footer-col.footer-col--products a { display: grid; justify-items: start; align-content: center; padding-block: 0.3rem; line-height: 1.3; }
  .fp-name { color: var(--ink); font-weight: 560; }
  .fp-kind { color: var(--ink-3); font-size: var(--fs-xs); }
  .footer-col--products a:hover .fp-name { color: var(--link-hover); }
  .footer-col ul { display: grid; gap: 0.15rem; padding: 0; margin: 0; list-style: none; }
  .footer-col a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-col a:hover { color: var(--link-hover); text-decoration: underline; text-decoration-color: var(--link-line); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  @media (max-width: 960px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-6) var(--s-4); }
    .footer-col--products, .footer-col--site { grid-column: 1 / -1; }
    .footer-col--site ul { grid-template-columns: 1fr 1fr; column-gap: var(--s-4); }
    .footer-col:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--s-4); }
    .footer-col:last-child .footer-label.mt { margin-top: 0; }
    .footer-col:last-child .footer-label:nth-of-type(2) { grid-column: 2; grid-row: 1; }
    .footer-col:last-child ul:nth-of-type(2) { grid-column: 2; grid-row: 2; }
  }
</style>
