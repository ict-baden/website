---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mailto } from '../config';
import { HOME, NAV_I18N, UI_SITE, sectionHref, type Lang } from '../i18n/site';

interface Props { lang?: Lang; alternates?: { lang: Lang; href: string }[] }
const { lang = 'de', alternates = [] } = Astro.props;
const T = UI_SITE[lang];
const nav = NAV_I18N[lang].map((n) => ({ href: sectionHref(lang, n.key), label: n.label }));
// Sprachumschalter: gleiche Seite in der anderen Sprache, sonst deren Startseite
const other: Lang = lang === 'de' ? 'en' : 'de';
const otherHref = alternates.find((a) => a.lang === other)?.href ?? HOME[other];
---
<header class="site-header">
  <span class="scroll-progress" aria-hidden="true"></span>
  <div class="container header-inner">
    <a class="brand" href={HOME[lang]} aria-label={T.toHome}>
      <Logo uid="h" />
    </a>

    <nav class="nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} data-spy>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-pressed="false" hidden>
        <span class="visually-hidden">{T.darkMode}</span>
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="lang-switch" href={otherHref} hreflang={other} lang={other} data-lang-switch={other} title={T.langOther}>
        <span class="visually-hidden">{T.langSwitch}: {T.langOther} – </span>
        <span class:list={['ls-opt', lang === 'de' && 'is-on']}>DE</span>
        <span class:list={['ls-opt', lang === 'en' && 'is-on']}>EN</span>
      </a>
      <a class="btn btn--sm header-cta" href={mailto(T.requestSubject)}>
        <Icon name="mail" />
        {T.request}
      </a>
      <details class="mnav" data-mnav>
        <summary class="icon-btn" aria-label={T.menu} data-label-open={T.menu} data-label-close={T.menuClose}>
          <Icon name="menu" class="i-open" />
          <Icon name="x" class="i-close" />
        </summary>
        <div class="mnav-panel">
          <nav aria-label={lang === 'de' ? 'Hauptnavigation (mobil)' : 'Main navigation (mobile)'}>
            <ul>
              <li><a href={HOME[lang]}>{T.home}</a></li>
              {nav.map((item) => (
                <li>
                  <a href={item.href} data-spy>
                    {item.label}
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
              <li><a href={otherHref} hreflang={other} lang={other} data-lang-switch={other}>{T.langOther}<Icon name="arrow-right" /></a></li>
            </ul>
          </nav>
          <a class="btn mnav-cta" href={mailto(T.requestSubject)}>
            <Icon name="mail" /> {T.request}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    /* 90 % deckend: bleibt lesbar, auch wo der Browser keinen Weichzeichner kann
       (das -webkit-Präfix ergänzt der Build, siehe build.cssTarget in astro.config.mjs) */
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 72px;
  }
  .brand { display: inline-flex; color: var(--ink); flex: none; border-radius: 6px; }
  .brand :global(.logo) { height: 46px; width: auto; }

  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 0.25rem; padding: 0; margin: 0; list-style: none; }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: var(--r-pill);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
    transition: color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .nav a[aria-current='page'], .nav a[aria-current='location'] { color: var(--ink); }
  .nav a[aria-current='page']::after, .nav a[aria-current='location']::after {
    content: '';
    position: absolute;
    left: 0.85rem; right: 0.85rem; bottom: 6px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-yellow) 0 62%, var(--brand-red) 62% 100%);
  }

  .header-actions { display: flex; align-items: center; gap: var(--s-2); }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--ink);
    transition: border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .icon-btn:hover { border-color: var(--ink-3); }
  .icon-btn[hidden] { display: none; }
  .theme-toggle :global(.icon) { grid-area: 1 / 1; transition: opacity var(--dur), transform 400ms var(--ease-out); }
  .theme-toggle :global(.i-sun) { opacity: 0; transform: rotate(-60deg) scale(0.6); }
  .theme-toggle[aria-pressed='true'] :global(.i-sun) { opacity: 1; transform: none; }
  .theme-toggle[aria-pressed='true'] :global(.i-moon) { opacity: 0; transform: rotate(60deg) scale(0.6); }

  /* Mobile Navigation */
  .mnav { display: none; }
  .mnav summary { list-style: none; }
  .mnav summary::-webkit-details-marker { display: none; }
  .mnav summary :global(.icon) { grid-area: 1 / 1; }
  .mnav :global(.i-close) { display: none; }
  .mnav[open] :global(.i-close) { display: block; }
  .mnav[open] :global(.i-open) { display: none; }
  .mnav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - 96px);
    overflow-y: auto;
    padding: var(--s-4) var(--gutter) var(--s-6);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .mnav-panel ul { padding: 0; margin: 0 0 var(--s-5); list-style: none; }
  .mnav-panel li + li { border-top: 1px solid var(--line); }
  .mnav-panel a:not(.btn) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    font-stretch: 104%;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  .mnav-panel a:not(.btn) :global(.icon) { color: var(--ink-3); }
  .mnav-panel a[aria-current='page'], .mnav-panel a[aria-current='location'] { color: var(--red-ink); }
  .mnav-cta { width: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .mnav[open] .mnav-panel { animation: drop 260ms var(--ease-out); }
  }
  @keyframes drop { from { opacity: 0; transform: translateY(-8px); } }

  @media (max-width: 1060px) {
    .header-cta { display: none; }
  }
  @media (max-width: 860px) {
    .nav { display: none; }
    .header-actions { margin-left: auto; }
    .mnav { display: block; }
    .header-inner { min-height: 64px; }
    .brand :global(.logo) { height: 40px; }
  }
  /* Lesefortschritt: dünner Balken in Baden-Gelb/-Rot am unteren Rand der Kopfzeile (scroll-getrieben, ohne JS) */
  .scroll-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, var(--brand-yellow) 0 70%, var(--brand-red)); pointer-events: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-progress { animation: scroll-progress linear both; animation-timeline: scroll(root); }
    }
  }
  @keyframes scroll-progress { to { transform: scaleX(1); } }
  /* Sprachumschalter DE | EN */
  .lang-switch { display: inline-flex; align-items: center; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-elev); text-decoration: none; font-size: var(--fs-xs); font-weight: 750; letter-spacing: 0.04em; }
  .ls-opt { padding: 0.32rem 0.6rem; border-radius: 999px; color: var(--ink-3); transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out); }
  .ls-opt.is-on { background: var(--brand-yellow); color: #111111; }
  .lang-switch:hover .ls-opt:not(.is-on) { color: var(--ink); }
  .lang-switch:focus-visible { outline: 3px solid var(--focus, var(--brand-yellow)); outline-offset: 2px; }
  @media (max-width: 860px) { .lang-switch { display: none; } }
</style>
