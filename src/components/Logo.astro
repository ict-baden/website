---
// Firmenlogo aus ict-baden/richtlinien: goldgelbes Feld, roter Schrägbalken nur über die rechte Seite,
// schwarze Wortmarke „ICT“ + „baden“ (Umrisse, siehe src/assets/brand/marke.json). Das Feld trägt seine
// eigenen Farben und funktioniert so unverändert im hellen und dunklen Design.
// variant="zeichen": Kurzzeichen (nur „ICT“) für kleine Flächen.
import marke from '../assets/brand/marke.json';

interface Props {
  /** eindeutiger Zusatz für die Clip-ID, wenn das Logo mehrfach auf einer Seite steht */
  uid: string;
  variant?: 'logo' | 'zeichen';
  class?: string;
}
const { uid, variant = 'logo', class: className } = Astro.props;
const clip = `ictb-feld-${uid}`;
const { gelb, schwarz, rot } = marke.colors;
const l = marke.logo;
const z = marke.zeichen;
const [fx, fy, fw, fh, fr] = z.field;
---
{variant === 'logo' ? (
  <svg class:list={['logo', className]} viewBox={`0 0 ${l.width} ${l.height}`} role="img" aria-label="ICT Baden" focusable="false">
    <defs><clipPath id={clip}><rect width={l.width} height={l.height} rx={l.radius} /></clipPath></defs>
    <g clip-path={`url(#${clip})`}>
      <rect width={l.width} height={l.height} fill={gelb} />
      <path d={l.bar} fill={rot} />
    </g>
    <path d={l.ict} fill={schwarz} />
    <path d={l.baden} fill={schwarz} />
  </svg>
) : (
  <svg class:list={['logo', 'logo--zeichen', className]} viewBox={`0 0 ${z.size} ${z.size}`} role="img" aria-label="ICT Baden" focusable="false">
    <defs><clipPath id={clip}><rect x={fx} y={fy} width={fw} height={fh} rx={fr} /></clipPath></defs>
    <g clip-path={`url(#${clip})`}>
      <rect width={z.size} height={z.size} fill={gelb} />
      <path d={z.bar} fill={rot} />
    </g>
    <path d={z.ict} fill={schwarz} />
  </svg>
)}
