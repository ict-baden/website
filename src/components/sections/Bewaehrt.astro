---
// Abschnitt „Bewährte Lösungen“ des One-Pagers: die älteren Eigenentwicklungen (Informant, CallCenter) und die
// kostenlosen Werkzeuge (ModbusExplorer, Pulswertigkeit) – früher verteilt auf Produkte und Downloads.
import Icon from '../Icon.astro';
import { mailto } from '../../config';
import type { IconName } from '../../lib/icons';

interface Item { id: string; cat: string; name: string; text: string; icon: IconName; badge: string; action: { label: string; href: string; icon: IconName; external?: boolean; note?: string } }
const items: Item[] = [
  { id: 'informant', cat: 'Alarmierung', name: 'Informant', text: 'Alarmierung im industriellen Umfeld.', icon: 'bell', badge: 'Im Einsatz · auf Anfrage',
    action: { label: 'Anfragen', href: mailto('Anfrage zu Informant'), icon: 'mail' } },
  { id: 'callcenter', cat: 'Telefonie', name: 'CallCenter', text: 'Industrieller Anrufbeantworter und Telefonzentrale.', icon: 'phone', badge: 'Im Einsatz · auf Anfrage',
    action: { label: 'Anfragen', href: mailto('Anfrage zu CallCenter'), icon: 'mail' } },
  { id: 'modbus', cat: 'Modbus', name: 'Modbus­Explorer', text: 'Kostenloses Werkzeug für Modbus TCP.', icon: 'protocol', badge: 'Kostenlos',
    action: { label: 'Download', href: 'https://modbus.de/explorer.html', icon: 'download', external: true, note: 'Download auf modbus.de' } },
  { id: 'pulswertigkeit', cat: 'Online-Werkzeug', name: 'Energiezähler | Pulswertigkeit', text: 'Berechnung der Pulswertigkeit aus Wandlerkonstante oder den Daten eines Messwandlerzählers – direkt im Browser.', icon: 'calculator', badge: 'Kostenlos',
    action: { label: 'Zum Rechner', href: '/werkzeuge/pulswertigkeit/', icon: 'arrow-right' } },
];
---
<section class="section bewaehrt" id="bewaehrt" aria-labelledby="bewaehrt-titel">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Bewährte Lösungen</p>
      <h2 id="bewaehrt-titel">Eigenentwicklungen und Werkzeuge</h2>
      <p class="lead">Seit Jahren im Einsatz: Alarmierung und Telefonie für die Industrie richten wir für Ihre Anlage ein und passen sie an. Die Werkzeuge sind kostenlos.</p>
    </div>
    <ul class="bw-grid" role="list">
      {items.map((it) => (
        <li class="bw reveal" id={it.id}>
          <p class="bw-cat">{it.cat}</p>
          <div class="bw-head">
            <span class="bw-icon"><Icon name={it.icon} /></span>
            <h3>{it.name}</h3>
          </div>
          <p class="bw-text">{it.text}</p>
          <span class="badge badge--verfuegbar">{it.badge}</span>
          <a class="btn btn--secondary bw-btn" href={it.action.href} rel={it.action.external ? 'noopener' : undefined}>
            <Icon name={it.action.icon} /> {it.action.label}
            {it.action.external && <span class="visually-hidden">(externe Seite modbus.de)</span>}
          </a>
          {it.action.note && <p class="bw-note">{it.action.note}</p>}
        </li>
      ))}
    </ul>
    <p class="bw-terms reveal">Die kostenlosen Werkzeuge sind zur Verwendung „wie sie sind“ gedacht; für ihre Funktion wird keine Garantie gegeben.</p>
  </div>
</section>

<style>
  .bw-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5); padding: 0; margin: 0; list-style: none; }
  .bw {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3);
    padding: clamp(1.3rem, 1rem + 1vw, 2rem); border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--bg-elev); box-shadow: var(--shadow-sm); scroll-margin-top: 110px;
    transition: transform 380ms var(--ease-out), box-shadow 380ms var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .bw:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--line-strong); }
  .bw-cat { color: var(--ink-3); font-size: var(--fs-xs); font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; }
  .bw-head { display: flex; align-items: center; gap: var(--s-3); }
  .bw-icon { display: inline-grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 14px; background: var(--brand-yellow); color: #111111; }
  .bw h3 { font-size: var(--fs-lg); overflow-wrap: normal; word-break: normal; hyphens: manual; min-width: 0; }
  .bw-head { min-width: 0; flex-wrap: nowrap; }
  .bw-text { color: var(--ink-2); }
  .bw-btn { margin-top: auto; }
  .bw-note { color: var(--ink-3); font-size: var(--fs-xs); }
  .bw-terms { margin-top: var(--s-5); color: var(--ink-3); font-size: var(--fs-sm); }
  @media (max-width: 1100px) { .bw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .bw-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
