---
// Abschnitt „Kontakt“ des One-Pagers (früher /kontakt/), mit interaktiver Anfahrt
import Anfahrt from '../Anfahrt.astro';
import Icon from '../Icon.astro';
import { COMPANY, mailto } from '../../config';
---
<section class="section kontakt" id="kontakt" aria-labelledby="kontakt-titel">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Kontakt</p>
      <h2 id="kontakt-titel">Sprechen wir über Ihr Projekt.</h2>
      <p class="lead to">{COMPANY.name}<br />z.Hd. {COMPANY.contactPerson}</p>
    </div>
  </div>
  <div class="container kgrid">
    <section class="kcard kcard--main reveal" aria-labelledby="k-post">
      <h3 id="k-post">Persönlich und per Post</h3>
      <dl class="kfacts">
        <div>
          <dt><Icon name="pin" /> Adresse</dt>
          <dd>{COMPANY.district}<br />{COMPANY.street}<br />{COMPANY.zip} {COMPANY.city}</dd>
        </div>
        <div>
          <dt><Icon name="mail" /> E-Mail</dt>
          <dd><a href={mailto()}>{COMPANY.email}</a></dd>
        </div>
        <div>
          <dt><Icon name="phone" /> Telefon</dt>
          <dd><a class="tel" href={COMPANY.mobileHref}>{COMPANY.mobile}</a></dd>
        </div>
        <div>
          <dt><Icon name="fax" /> Fax</dt>
          <dd>NICHT MÖGLICH</dd>
        </div>
      </dl>
      <div class="btn-row">
        <a class="btn" href={mailto('Anfrage über die Website')}><Icon name="mail" /> E-Mail schreiben</a>
        <a class="btn btn--secondary" href={COMPANY.mobileHref}><Icon name="phone" /> Anrufen</a>
      </div>
    </section>

    <section class="kcard reveal" aria-labelledby="k-profile">
      <h3 id="k-profile">Profile</h3>
      <ul class="profiles" role="list">
        <li>
          <a href="https://www.freelance.de/Freiberufler/91924" rel="noopener">
            <span class="pi"><Icon name="briefcase" /></span>
            <span><strong>freelance</strong><span>Profil und Verfügbarkeit</span></span>
            <Icon name="arrow-up-right" label="(externer Link)" class="pext" />
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/frank-pfattheicher" rel="noopener">
            <span class="pi"><Icon name="linkedin" /></span>
            <span><strong>LinkedIn</strong><span>Profil</span></span>
            <Icon name="arrow-up-right" label="(externer Link)" class="pext" />
          </a>
        </li>
        <li>
          <a href="https://github.com/FrankPfattheicher" rel="noopener">
            <span class="pi"><Icon name="code" /></span>
            <span><strong>Github</strong><span>Open Source Repositories</span></span>
            <Icon name="arrow-up-right" label="(externer Link)" class="pext" />
          </a>
        </li>
      </ul>
    </section>
  </div>


  <div class="container anfahrt" id="anfahrt">
    <div class="section-head reveal anf-head">
      <p class="eyebrow">Anfahrt</p>
      <h3 id="k-anfahrt" class="h2">So finden Sie uns</h3>
    </div>
    <Anfahrt />
  </div>
</section>

<style>
  .to { margin-top: var(--s-5); color: var(--ink); }
  .kgrid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--s-5); }
  .kcard { padding: clamp(1.4rem, 1rem + 1.5vw, 2.4rem); border: 1px solid var(--line); border-radius: var(--r-xl); background: var(--bg-elev); box-shadow: var(--shadow-sm); }
  .kcard h3 { font-size: var(--fs-xl); margin-bottom: var(--s-5); }
  .kfacts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); margin: 0 0 var(--s-6); }
  .kfacts dt { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--ink-3); font-size: var(--fs-xs); font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
  .kfacts dt :global(.icon) { width: 1rem; height: 1rem; }
  .kfacts dd { margin: 0.35rem 0 0; color: var(--ink); font-weight: 560; line-height: 1.5; }
  .profiles { display: grid; gap: var(--s-3); padding: 0; margin: 0; list-style: none; }
  .profiles a {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .profiles a:hover { border-color: var(--line-strong); background: var(--bg-elev-2); color: var(--ink); }
  .profiles a > span:nth-child(2) { display: grid; }
  .profiles a > span:nth-child(2) span { color: var(--ink-2); font-size: var(--fs-sm); }
  .pi { display: inline-grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 12px; background: var(--brand-yellow); color: #111111; }
  .profiles :global(.pext) { margin-left: auto; width: 1.1rem; height: 1.1rem; color: var(--ink-3); }


  @media (max-width: 900px) {
    .kgrid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) { .kfacts { grid-template-columns: minmax(0, 1fr); } }
  .anfahrt { margin-top: var(--s-9); }
  .anf-head .h2 { font-size: var(--fs-2xl, 2rem); }
</style>