---
// Interaktive Anfahrt: Karte im Stil der Marke (nachgezeichnet aus dem bisherigen Lageplan, gleiche Straßen,
// Haltestellen und Parkplätze), vier Wege (A5, A8, Zug, Straßenbahn). Mit JavaScript (public/js/anfahrt.js)
// zeichnet sich der gewählte Weg, ein Symbol fährt ihn ab und die Schritte daneben leuchten mit. Ohne JavaScript
// oder mit „Bewegung reduzieren“ ist alles sofort vollständig sichtbar.
import Icon from './Icon.astro';
import { COMPANY } from '../config';
import sat from '../data/luftbild.json';

// Die Kartendienste und „Adresse kopieren“ zeigen auf die Anschrift (Seboldstraße 9), nicht auf die Hofeinfahrt
const navTarget = `${COMPANY.street}, ${COMPANY.zip} ${COMPANY.city}`;
const q = encodeURIComponent(navTarget);
const links = [
  { label: 'Google Maps', href: `https://www.google.com/maps/dir/?api=1&destination=${q}` },
  { label: 'Apple Karten', href: `https://maps.apple.com/?daddr=${q}` },
  { label: 'OpenStreetMap', href: `https://www.openstreetmap.org/search?query=${q}` },
];

// Gemeinsame Strecke ab der Ausfahrt: Durlacher Allee › Pforzheimer Straße › Pfinzstraße › Zur Gießerei › Parkplatz
const TAIL = 'L 340 289 L 727.6 393.9 L 800.4 305 L 824 307.6 L 830 322 L 856 322';

// Luftbild mit Wegen auf den echten Straßen: erzeugt von scripts/make-luftbild.py (Orthofoto des LGL, Wege mit OSRM
// auf OpenStreetMap-Daten); sat = Anteil des Weges, ab dem ein Schritt auf dem Luftbild gilt
const SAT_ZUG = sat.zug;
const SAT_TRAM = sat.tram;
const [ictX, ictY] = sat.ict;

const modes = [
  {
    id: 'a5', icon: 'car', tab: 'A5', title: 'A5 aus Richtung Basel oder Frankfurt', ordered: true,
    ride: `M 470 40 L 262 239 C 236 262, 205 300, 172 288 C 140 276, 150 236, 190 245 ${TAIL}`, walk: null, satRide: sat.a5, satWalk: null, sat: sat.satA5,
    steps: [
      [0.237, 'Ausfahrt 44 Karlsruhe-Durlach'],
      [0.392, 'Sie fahren auf die B10 (Durlacher Allee) in Richtung Durlach'],
      [0.521, 'Und folgen der Durlacher Allee weiter in Richtung Durlach (nicht der B10 folgen!)'],
      [0.852, 'An der nun folgenden Kreuzung biegen Sie links in die Pforzheimer Straße ein'],
      [0.946, 'An der nächsten Kreuzung fahren Sie rechts in die Pfinzstraße'],
      [0.966, 'Und biegen direkt danach rechts in die Hofeinfahrt „Zur Gießerei“ ein'],
      [0.979, 'Sofort wieder links abbiegen'],
      [1, 'Geradeaus zu Ihrer Linken befinden sich die ausgezeichneten Parkplätze'],
    ],
  },
  {
    id: 'a8', icon: 'car', tab: 'A8', title: 'A8 aus Richtung Stuttgart', ordered: true,
    ride: `M 22 474 L 160 340 Q 240 298 ${TAIL.slice(2)}`, walk: null, satRide: sat.a8, satWalk: null, sat: sat.satA8,
    steps: [
      [0, 'Fahren Sie über die Autobahn A8 bis zum Dreieck Karlsruhe'],
      [0.06, 'Wechseln Sie auf die A5 Richtung Frankfurt'],
      [0.2, 'Ausfahrt 44 Karlsruhe-Durlach'],
      [0.4, 'Von dort folgen Sie der Wegbeschreibung aus Richtung Basel und Frankfurt'],
    ],
  },
  {
    id: 'zug', icon: 'train', tab: 'Zug', title: 'Mit dem Zug', ordered: false,
    ride: 'M 300 509 L 655 290', walk: 'M 655 290 L 662 312 L 710 296 L 800.4 305 L 824 307.6 L 830 322 L 858 346', satRide: null, satWalk: SAT_ZUG, sat: [0, 0],
    steps: [
      [0, 'Vom Hauptbahnhof Karlsruhe können Sie mit einer beliebigen Bahn fahren, die am Bahnhof Karlsruhe-Durlach (siehe Karte) Halt macht, z. B. S3, S31, S32'],
      [0.5, 'Vom Bahnhof Karlsruhe-Durlach 5 Minuten Fußweg'],
    ],
  },
  {
    id: 'tram', icon: 'tram', tab: 'Straßenbahn', title: 'Straßenbahn', ordered: false,
    ride: 'M 10 197 L 688 386', walk: 'M 688 386 L 838 428 L 862 371', satRide: null, satWalk: SAT_TRAM, sat: [0, 0, 0],
    steps: [
      [0, 'Straßenbahn Linie 1 in Richtung Durlach'],
      [0.05, 'oder Linie 2 in Richtung Wolfartsweier bis zur Haltestelle „Auer Straße“'],
      [0.8, '5 Minuten Fußweg'],
    ],
  },
] as const;
---
<div class="anf" data-anfahrt>
  <div class="anf-tabs" role="tablist" aria-label="Anreise wählen" hidden data-tabs>
    {modes.map((m, i) => (
      <button class="anf-tab" type="button" role="tab" id={`tab-${m.id}`} aria-controls={`steps-${m.id}`}
        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-mode={m.id}>
        <Icon name={m.icon} /> {m.tab}
      </button>
    ))}
  </div>

  <div class="anf-grid">
    <figure class="anf-map">
      <div class="anf-view" role="group" aria-label="Ansicht" hidden data-views>
        <button type="button" class="anf-vb" aria-pressed="true" data-view="plan">Plan</button>
        <button type="button" class="anf-vb" aria-pressed="false" data-view="sat">Luftbild</button>
      </div>
      <div class="anf-stage">
      <svg viewBox="0 0 966 540" role="img" aria-labelledby="anf-map-title" class="anf-plan-svg">
        <title id="anf-map-title">Lageplan: A5 mit Ausfahrt KA-Durlach, B10 Durlacher Allee mit den Straßenbahnlinien 1 und 2, Haltestellen Auer Straße und Friedrichschule, Bahnhof Karlsruhe-Durlach, Pforzheimer Straße, Pfinzstraße, Zur Gießerei mit Parkplatz und dem ICT-Gebäude an der Seboldstraße.</title>
        <defs>
          <pattern id="anf-grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M 24 0 L 0 0 0 24" class="g-grid" />
          </pattern>
          <radialGradient id="anf-glow" cx="0.88" cy="0.62" r="0.5">
            <stop offset="0" class="g-glow-in" />
            <stop offset="1" class="g-glow-out" />
          </radialGradient>
        </defs>
        <rect width="966" height="540" class="g-bg" />
        <rect width="966" height="540" fill="url(#anf-grid)" />
        <rect width="966" height="540" fill="url(#anf-glow)" />

        <!-- Straßen -->
        <g class="g-roads">
          <path d="M 18 478 L 476 30" class="g-hwy" />
          <path d="M 18 478 L 476 30" class="g-hwy-in" />
          <path d="M 168 352 Q 240 300 340 292" class="g-ramp" />
          <path d="M 262 239 C 236 262, 205 300, 172 288 C 140 276, 150 236, 190 245" class="g-ramp" />
          <path d="M 10 197 L 910 448" class="g-main" />
          <path d="M 440 330 C 425 355, 455 362, 480 346 L 765 172" class="g-street" />
          <path d="M 628 522 L 904 176" class="g-street" />
          <path d="M 638 326 L 710 296 L 912 318" class="g-street" />
          <path d="M 778 398 L 797 322 L 822 324" class="g-lane" />
          <path d="M 868 330 L 912 330 M 884 348 L 920 348 M 884 372 L 914 372 M 842 398 L 906 404" class="g-lane" />
          <path d="M 835 425 L 875 345" class="g-sebold" />
          <path d="M 10 197 L 910 448" class="g-tram" />
        </g>
        <!-- Bahnstrecke (Karlsruhe Hbf – Durlach) durch den Bahnhof -->
        <g class="g-rail">
          <path d="M 250 540 L 655 290 L 966 98" class="g-rail-bed" />
          <path d="M 250 540 L 655 290 L 966 98" class="g-rail-ties" />
        </g>

        <!-- Beschriftungen -->
        <g class="g-labels">
          <text x="452" y="24">Frankfurt</text>
          <text x="26" y="510">Basel</text><text x="26" y="528">Stuttgart</text>
          <text x="432" y="122" class="g-strong">A5</text>
          <text x="58" y="402" class="g-strong">A5</text>
          <text x="322" y="276">B10 Durlacher Allee</text>
          <text x="706" y="192" class="g-strong">B10</text>
          <text x="502" y="212">Bahnhof</text><text x="502" y="230">Karlsruhe-Durlach</text>
          <text transform="translate(676 478) rotate(-51.4)" class="g-small">Pforzheimer Straße</text>
          <text x="850" y="298" class="g-small">Pfinzstraße</text>
          <text x="760" y="374" class="g-small">Zur Gießerei</text>
          <text x="840" y="398" class="g-small">Seboldstraße</text>
          <text x="770" y="458" class="g-small">Pfinztalstraße</text>
        </g>

        <!-- Autobahnausfahrt, Bahnhof, Haltestellen, Parkplatz -->
        <g class="g-signs">
          <g transform="translate(210 338)">
            <path d="M 0 0 H 112 L 128 16 L 112 32 H 0 Z" class="g-exit" />
            <text x="10" y="22" class="g-exit-t">KA-Durlach</text>
          </g>
          <g transform="translate(70 178)">
            <rect width="18" height="20" rx="2" class="g-l1" /><text x="9" y="15" class="g-ln">1</text>
            <rect x="20" width="18" height="20" rx="2" class="g-l2" /><text x="29" y="15" class="g-ln">2</text>
            <text x="46" y="15" class="g-tram-t">Straßenbahn</text>
          </g>
          <g transform="translate(655 296)" class="g-pt">
            <rect x="-15" y="-15" width="30" height="30" rx="6" class="g-station" />
            <path d="M -7 -8 H 7 A 3 3 0 0 1 10 -5 V 5 A 3 3 0 0 1 7 8 H -7 A 3 3 0 0 1 -10 5 V -5 A 3 3 0 0 1 -7 -8 Z M -6 -4 V 0 H 6 V -4 Z M -8 10 L -11 14 M 8 10 L 11 14" class="g-station-i" />
          </g>
          <g transform="translate(688 375)" class="g-pt g-stop" data-stop="auer">
            <circle r="11" class="g-stop-c" /><text y="5" class="g-stop-t">H</text>
          </g>
          <text x="540" y="412" class="g-stop-l">Haltestelle Auer Straße (1, 2)</text>
          <g transform="translate(905 436)" class="g-pt g-stop">
            <circle r="11" class="g-stop-c" /><text y="5" class="g-stop-t">H</text>
          </g>
          <text x="952" y="478" class="g-stop-l g-end">Haltestelle Friedrichschule (1)</text>
          <g transform="translate(862 308)" class="g-park" data-park>
            <rect x="-11" y="-11" width="22" height="22" rx="4" class="g-park-r" /><text y="6" class="g-park-t">P</text>
          </g>
        </g>

        <!-- Wege -->
        {modes.map((m) => (
          <g class:list={['g-route', `g-route--${m.id}`]} data-route={m.id}>
            <path d={m.ride} class="g-ride-glow" />
            <path d={m.ride} class="g-ride" data-ride />
            {m.walk && (
              <>
                <mask id={`anf-m-${m.id}`} maskUnits="userSpaceOnUse" x="0" y="0" width="966" height="540">
                  <path d={m.walk} class="g-walk-mask" data-walk-mask />
                </mask>
                <path d={m.walk} class="g-walk" mask={`url(#anf-m-${m.id})`} data-walk />
              </>
            )}
          </g>
        ))}

        <!-- Ziel -->
        <g transform="translate(862 358)" class="g-dest">
          <circle r="26" class="g-pulse" />
          <circle r="26" class="g-pulse g-pulse--2" />
          <path d="M 0 14 C -10 2, -14 -4, -14 -10 A 14 14 0 0 1 14 -10 C 14 -4, 10 2, 0 14 Z" class="g-pin" />
          <text y="-6" class="g-pin-t">ICT</text>
        </g>

        <!-- Fahrendes Symbol -->
        <g class="g-mover" data-mover>
          <circle r="13" class="g-mover-c" />
          <circle r="5" class="g-mover-d" />
        </g>
      </svg>
      <!-- Luftbild (DOP20 des LGL, Datenlizenz Deutschland – Namensnennung 2.0), lädt erst beim Umschalten -->
      <svg viewBox="0 0 966 540" role="img" aria-label="Luftbild der Umgebung von der Ausfahrt Karlsruhe-Durlach bis zur Seboldstraße 9: ICT Baden, Bahnhof Karlsruhe-Durlach und Haltestelle Auer Straße" class="anf-sat" data-sat>
        <g class="s-zoom">
          <image width="966" height="540" data-src="/media/kontakt/luftbild-1932.webp" />
          <!-- Wege und Markierungen im Zoom, damit sie auf dem Luftbild bleiben -->
          {modes.map((m) => (
            <g class:list={['g-route', 's-route', `g-route--${m.id}`]} data-route={m.id}>
              {m.satRide && m.satRide.map((r) => (
                <>
                  <path d={r} class="g-ride-glow" />
                  <path d={r} class="g-ride" data-ride />
                </>
              ))}
              {m.satWalk && (
                <>
                  <mask id={`anf-sm-${m.id}`} maskUnits="userSpaceOnUse" x="-200" y="-200" width="1366" height="940">
                    <path d={m.satWalk} class="g-walk-mask" data-walk-mask />
                  </mask>
                  <path d={m.satWalk} class="g-walk s-walk" mask={`url(#anf-sm-${m.id})`} data-walk />
                </>
              )}
            </g>
          ))}
          <g transform={`translate(${sat.bahnhof[0]} ${sat.bahnhof[1]})`} class="s-mark">
            <circle r="9" class="s-dot" /><circle r="16" class="s-ring" />
            <g transform="translate(-212 -30)"><rect width="196" height="30" rx="15" class="s-tag" /><text x="14" y="20" class="s-tag-t">Bahnhof Karlsruhe-Durlach</text></g>
          </g>
          <g transform={`translate(${sat.auer[0]} ${sat.auer[1]})`} class="s-mark"><circle r="9" class="s-stop" /><g transform="translate(-190 -44)"><rect width="176" height="28" rx="14" class="s-tag" /><text x="12" y="19" class="s-tag-t">Haltestelle Auer Straße</text></g></g>
          <g class="g-mover" data-mover><circle r="11" class="g-mover-c" /><circle r="4.5" class="g-mover-d" /></g>
        </g>
        <rect width="966" height="540" class="s-shade" />
        <g transform={`translate(${ictX} ${ictY})`} class="s-ict">
          <circle r="30" class="g-pulse s-pulse" />
          <circle r="30" class="g-pulse s-pulse g-pulse--2" />
          <g class="s-pin"><path d="M 0 0 C -14 -16, -20 -24, -20 -32 A 20 20 0 0 1 20 -32 C 20 -24, 14 -16, 0 0 Z" class="g-pin" /><text y="-28" class="s-pin-t">ICT</text></g>
          <g transform="translate(-196 -116)"><rect width="214" height="48" rx="12" class="s-card" /><text x="14" y="21" class="s-card-h">ICT Baden GmbH</text><text x="14" y="38" class="s-card-t">Seboldstraße 9, 76227 Karlsruhe</text></g>
        </g>
        <g transform="translate(24 508)" class="s-scale">
          <rect x="-8" y="-20" width={sat.scale.units + 62} height="30" rx="6" class="s-scale-bg" />
          <g class="s-scale-z"><path d={`M 0 0 H ${sat.scale.units} M 0 -5 V 5 M ${sat.scale.units} -5 V 5`} class="s-scale-l" /></g><text x={sat.scale.units + 8} y="4" class="s-scale-t">{sat.scale.meters} m</text>
        </g>
      </svg>
      </div>
      <p class="anf-credit" hidden data-credit>Luftbild: <a href="https://www.lgl-bw.de" rel="noopener">LGL-BW</a> (2026), <a href="https://www.govdata.de/dl-de/by-2-0" rel="noopener">Datenlizenz Deutschland – Namensnennung – Version 2.0</a> · Wege: © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap-Mitwirkende</a></p>
      <figcaption class="anf-legend">
        <span><i class="lg lg-ride"></i> Fahrt</span>
        <span><i class="lg lg-walk"></i> zu Fuß</span>
        <span><i class="lg lg-tram"></i> Straßenbahn 1, 2</span>
        <span><i class="lg lg-park">P</i> Parkplatz</span>
      </figcaption>
    </figure>

    <div class="anf-side">
      {modes.map((m, i) => (
        <section class="anf-steps" id={`steps-${m.id}`} role="tabpanel" aria-labelledby={`tab-${m.id}`} data-steps={m.id} data-active={i === 0 ? '' : undefined}>
          <h3><span class="anf-si"><Icon name={m.icon} /></span>{m.title}</h3>
          {m.ordered ? (
            <ol>{m.steps.map(([at, t], k) => <li data-at={at} data-sat={m.sat[k]}>{t}</li>)}</ol>
          ) : (
            <ul>{m.steps.map(([at, t], k) => <li data-at={at} data-sat={m.sat[k]}>{t}</li>)}</ul>
          )}
        </section>
      ))}
      <button class="anf-replay" type="button" hidden data-replay><Icon name="route" /> Weg noch einmal zeigen</button>
    </div>
  </div>

  <div class="anf-go">
    <div class="anf-addr">
      <h3>Anschrift</h3>
      <p>{COMPANY.name}<br />{COMPANY.street}<br />{COMPANY.zip} {COMPANY.city}</p>
      <p class="anf-navi"><Icon name="route" /><span>Im Navigationssystem: <strong class="nowrap">„{COMPANY.navAddress}“</strong></span></p>
    </div>
    <div class="anf-plan">
      <p class="anf-go-t"><Icon name="pin" /> Route planen</p>
      <div class="anf-go-b">
        {links.map((l) => (
          <a class="anf-btn" href={l.href} rel="noopener" target="_blank">{l.label} <Icon name="arrow-up-right" /></a>
        ))}
        <button class="anf-btn anf-btn--copy" type="button" hidden data-copy={navTarget}><Icon name="file" /> <span data-copy-label>Adresse kopieren</span></button>
      </div>
      <p class="anf-note">Öffnet den Kartendienst in einem neuen Tab – vorher wird nichts übertragen. <a href="/Anfahrtsbeschreibung.pdf">Anfahrt als PDF</a></p>
    </div>
  </div>
</div>

<style>
  .anf { --map-bg: #111111; --road: #3a3a3a; --road-2: #2a2a2a; --label: #bdbdbd; --label-2: #8a8a8a; --route: var(--brand-yellow); }
  .anf-tabs { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-5); }
  .anf-tab {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.1rem; border: 1px solid var(--line);
    border-radius: 999px; background: var(--bg-elev); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer;
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .anf-tab :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .anf-tab:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  .anf-tab[aria-selected='true'] { background: var(--brand-yellow); border-color: var(--brand-yellow); color: #111111; }

  .anf-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.85fr); gap: var(--s-6); align-items: start; }
  .anf-map { margin: 0; border-radius: var(--r-xl); overflow: hidden; background: var(--map-bg); box-shadow: var(--shadow-md); border: 1px solid rgb(255 255 255 / 0.06); }
  .anf-map { position: relative; }
  .anf-stage { display: grid; }
  .anf-stage > svg { grid-area: 1 / 1; display: block; width: 100%; height: auto; }
  .anf-sat { opacity: 0; visibility: hidden; transition: opacity 600ms var(--ease-out), visibility 0s linear 600ms; background: #111; }
  .anf.is-sat .anf-sat { opacity: 1; visibility: visible; transition: opacity 600ms var(--ease-out); }
  .anf-view { position: absolute; z-index: 2; top: 14px; right: 14px; display: flex; padding: 4px; border-radius: 999px; background: rgb(17 17 17 / 0.72); backdrop-filter: blur(8px); border: 1px solid rgb(255 255 255 / 0.14); }
  .anf-vb { padding: 0.4rem 0.95rem; border: 0; border-radius: 999px; background: transparent; color: #e5e5e5; font: inherit; font-size: var(--fs-sm); font-weight: 650; cursor: pointer; }
  .anf-vb[aria-pressed='true'] { background: var(--brand-yellow); color: #111111; }
  .anf-credit { margin: 0; padding: var(--s-2) var(--s-5) var(--s-3); background: #161616; color: #9a9a9a; font-size: 11px; }
  .anf-credit a { color: #bdbdbd; }
  /* Zoom-Ursprung = ICT aus src/data/luftbild.json */
  .s-zoom { transform-box: view-box; transform-origin: 869.6px 283.3px; transition: transform 7s cubic-bezier(0.22, 1, 0.36, 1); }
  .anf.is-sat .s-zoom { transform: scale(1.06); }
  .s-shade { fill: rgb(0 0 0 / 0.12); }
  .s-mark, .s-ict { opacity: 0; transition: opacity 500ms var(--ease-out) 900ms; }
  .anf.is-sat .s-mark, .anf.is-sat .s-ict { opacity: 1; }
  .s-stop { fill: #facc15; stroke: #14532d; stroke-width: 3; }
  .s-walk { stroke-width: 4.5; }
  .s-dot { fill: #2563eb; stroke: #fff; stroke-width: 3; }
  .s-ring { fill: none; stroke: #fff; stroke-width: 2; opacity: 0.7; }
  .s-tag { fill: rgb(17 17 17 / 0.82); }
  .s-tag-t { fill: #fff; font-size: 13px; font-weight: 650; }
  .s-pin { transform-box: fill-box; transform-origin: 50% 100%; }
  .anf.is-sat .s-pin { animation: anf-drop 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 900ms both; }
  @keyframes anf-drop { from { transform: translateY(-40px) scale(0.6); opacity: 0; } to { transform: none; opacity: 1; } }
  .s-pin .g-pin { fill: var(--brand-red); stroke: #fff; stroke-width: 2.5; }
  .s-pin-t { fill: #fff; font-size: 11px; font-weight: 900; text-anchor: middle; }
  .anf.is-sat .s-pulse { animation: anf-pulse 2.2s var(--ease-out) 1.4s infinite; }
  .anf.is-sat .s-pulse.g-pulse--2 { animation-delay: 2.5s; }
  .s-card { fill: rgb(17 17 17 / 0.86); stroke: var(--brand-yellow); stroke-width: 1.5; }
  .s-card-h { fill: var(--brand-yellow); font-size: 14px; font-weight: 800; }
  .s-card-t { fill: #fff; font-size: 12.5px; }
  .s-scale-bg { fill: rgb(17 17 17 / 0.7); }
  .s-scale-l { stroke: #fff; stroke-width: 2.5; fill: none; }
  /* Der Maßstab wächst mit dem Zoom (gleiche Dauer und Kurve), damit 100 m stimmen */
  .s-scale-z { transform-box: fill-box; transform-origin: 0 50%; transition: transform 7s cubic-bezier(0.22, 1, 0.36, 1); }
  .anf.is-sat .s-scale-z { transform: scaleX(1.06); }
  .s-scale-t { transition: transform 7s cubic-bezier(0.22, 1, 0.36, 1); }
