---
// Seitenkopf für Unterseiten: Brotkrumen, kleine Überschrift, Titel, Einleitung. lang: Sprache der Brotkrumen
// (englisch: Startseite /en/ und „Breadcrumb“).
interface Crumb { href?: string; label: string }
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  narrow?: boolean;
  lang?: 'de' | 'en';
}
const { eyebrow, title, lead, crumbs = [], narrow = false, lang = 'de' } = Astro.props;
const en = lang === 'en';
---
<section class="phero">
  <div class="phero-bg" aria-hidden="true"><span class="phero-field"><span class="phero-bar"></span></span></div>
  <div class:list={['container', narrow && 'container--narrow', 'phero-inner']}>
    {crumbs.length > 0 && (
      <nav aria-label={en ? 'Breadcrumb' : 'Brotkrumen'}>
        <ol class="crumbs">
          <li><a href={en ? '/en/' : '/'}>{en ? 'ICT Baden' : 'Start'}</a></li>
          {crumbs.map((c, i) => (
            <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead phero-lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; overflow: clip; padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 3.5rem); }
  .phero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
  }
  /* Ecke wie beim Kurzzeichen: gelbes Feld oben rechts, roter Balken nur über dessen rechte Seite */
  .phero-field {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--pf-w, clamp(84px, 17vw, 260px));
    /* feste Eckhöhe statt voller Kopfhöhe: endet deutlich über dem Inhalt darunter */
    height: min(100%, var(--pf-h, clamp(9rem, 22vw, 18rem)));
    overflow: hidden;
    border-bottom-left-radius: 2px;
  }
  .phero-field::before, .phero-bar {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    transform: skewX(var(--bar-angle));
    transform-origin: 0 0;
  }
  .phero-field::before { left: 0; right: -200%; background: var(--brand-yellow); }
  .phero-bar { left: 46%; width: 18%; background: var(--brand-red); }
  @media (max-width: 720px) {
    .phero-field { --pf-w: 72px; --pf-h: 9rem; }
  }
  .phero-inner { position: relative; }
  h1 { max-width: 20ch; }
  .phero-lead { margin-top: var(--s-5); }
</style>
