---
// Seitenkopf für Unterseiten: Brotkrumen, kleine Überschrift, Titel, Einleitung.
interface Crumb { href?: string; label: string }
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  narrow?: boolean;
}
const { eyebrow, title, lead, crumbs = [], narrow = false } = Astro.props;
---
<section class="phero">
  <div class="phero-bg" aria-hidden="true"></div>
  <div class:list={['container', narrow && 'container--narrow', 'phero-inner']}>
    {crumbs.length > 0 && (
      <nav aria-label="Brotkrumen">
        <ol class="crumbs">
          <li><a href="/">Start</a></li>
          {crumbs.map((c, i) => (
            <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead phero-lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; overflow: clip; padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 3.5rem); }
  .phero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(34rem 18rem at 88% 0%, color-mix(in srgb, var(--brand-yellow) 26%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 80% 100% at 80% 0%, #000 20%, transparent 75%);
  }
  .phero-inner { position: relative; }
  h1 { max-width: 20ch; }
  .phero-lead { margin-top: var(--s-5); }
</style>
