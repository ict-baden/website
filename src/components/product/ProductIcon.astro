---
// Produktsymbol: Logo aus dem Repo, sonst erzeugte Kachel im gleichen Stil.
import { productGlyph } from '../../lib/art';
import type { Product } from '../../lib/products';
interface Props { product: Product; size?: number; uid?: string; class?: string }
const { product, size = 48, uid = '', class: className } = Astro.props;
---
{product.media.logo
  ? <img class:list={['picon', className]} src={product.media.logo} width={size} height={size} alt="" loading="lazy" decoding="async" />
  : <span class:list={['picon', className]} set:html={productGlyph(product.slug, product.linie, uid)} />}

<style>
  .picon { display: block; flex: none; width: var(--picon-size, 48px); height: var(--picon-size, 48px); filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.16)); }
  .picon :global(svg) { width: 100%; height: 100%; }
</style>
