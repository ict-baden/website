---
// Produktsymbol im Stil der App-Icon-Vorlage: erzeugt (src/assets/product-icons) oder eigenes Symbol aus dem Repo.
import { productGlyph } from '../../lib/art';
import { productIconUrl } from '../../lib/product-icons';
import type { Product } from '../../lib/products';
interface Props { product: Product; size?: number; uid?: string; class?: string; eager?: boolean }
const { product, size = 48, uid = '', class: className, eager = false } = Astro.props;
const url = productIconUrl(product);
---
{url
  ? <img class:list={['picon', className]} src={url} width={size} height={size} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  : <span class:list={['picon', className]} set:html={productGlyph(product.slug, product.linie, uid)} />}

<style>
  .picon { display: block; flex: none; width: var(--picon-size, 48px); height: var(--picon-size, 48px); filter: drop-shadow(0 4px 10px rgb(17 17 17 / 0.16)); }
  .picon :global(svg) { width: 100%; height: 100%; }
</style>
