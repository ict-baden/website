---
// Produktseite (deutsch unter /produkte/<slug>/, englisch unter /en/products/<slug>/): Antwort zuerst, Funktionen,
// Bilder, Systemvoraussetzungen, ehrliche Grenzen, FAQ, verwandte Produkte – mit JSON-LD (SoftwareApplication,
// FAQPage, BreadcrumbList) und hreflang. Inhalte: products.json (Sync) und src/data/produktseiten/<id>.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import ThemeImage from '../ThemeImage.astro';
import StatusBadge from '../StatusBadge.astro';
import ContactBand from '../ContactBand.astro';
import ProductIcon from './ProductIcon.astro';
import GuideTeaser from '../guide/GuideTeaser.astro';
import { coverArt } from '../../lib/art';
import { colorClasses, isPortrait, lineById, nameHtml, nameSize, products, type Product, type Shot } from '../../lib/products';
import { fill, inline, isReleased, LINE_EN, lineAnchorFor, pageFor, plain, productsUrlFor, productUrlFor, seoTitle, statusLabelFor, UI, type Lang } from '../../lib/produktseiten';
import { breadcrumbs, faqPage, organization, productOgImage, softwareApplication, webPage, website } from '../../lib/seo';
import privacyPages from '../../data/app-datenschutz';
import { mailto } from '../../config';

interface Props { product: Product; lang: Lang }
const { product: p, lang } = Astro.props;
const t = UI[lang];
const page = pageFor(p);
const copy = page[lang];
const other: Lang = lang === 'de' ? 'en' : 'de';
const f = (s: string) => fill(s, page, p, lang);

const line = lineById(p.linie);
const lineName = lang === 'de' ? line.name : LINE_EN[line.id]?.name ?? line.name;
const kind = (lang === 'de' ? p.kind : copy.kind ?? p.kind) ?? '';
const tagline = lang === 'de' ? p.tagline : copy.tagline ?? null;
const url = productUrlFor(p, lang);
const otherUrl = productUrlFor(p, other);
const released = isReleased(p);
const statusLabel = statusLabelFor(p, lang);
const facts: [string, string][] = lang === 'de' ? p.facts.map((x) => [x.label, x.value]) : copy.facts ?? [];

const m = p.media;
/** Bildtexte in der Sprache der Seite */
const txt = (s: Shot) => (lang === 'en' && s.en ? s.en : { title: s.title, caption: s.caption, alt: s.alt });
const hero = m.screenshots[0];
const phones = Boolean(hero && isPortrait(hero));
const heroPhones = phones ? m.screenshots.slice(0, 3) : [];
const gallery = m.demo || phones ? m.screenshots : m.screenshots.slice(1);
const shotKind = (x: Shot) => (isPortrait(x) ? 'phone' : x.light.width / x.light.height >= 2.4 ? 'wide' : x.light.width <= 1100 ? 'small' : 'normal');
/** Alternativtext und Bildunterschrift der Demo-Animation in der Sprache der Seite */
const demoText = m.demo ? (lang === 'en' && m.demo.en ? m.demo.en : { alt: m.demo.alt, caption: m.demo.caption }) : null;
const galleryNote = lang === 'en' ? m.galleryNoteEn ?? null : m.galleryNote;

const related = page.related.map((id) => products.find((x) => x.id === id)).filter((x): x is Product => Boolean(x));
const relatedKind = (r: Product) => (lang === 'de' ? r.kind : pageFor(r).en.kind ?? r.kind);
// Datenschutzerklärung der App (src/data/app-datenschutz.ts), gefunden über die Projekt-id
const privacySlug = privacyPages.find((a) => a.productId === p.id)?.slug;
const privacy = privacySlug ? `/datenschutz/${privacySlug}/` : null;
// Sachlicher Vergleich mit Fremdprodukten (Comparison in src/lib/produktseiten.ts). data-vergleich markiert den
// Abschnitt und seine FAQ-Fragen: nur dort dürfen Fremdnamen stehen (scripts/check-seo.mjs), data-marken den Markenhinweis.
const comparison = page.alternatives?.approved ? page.alternatives[lang] : null;
const faqs = [...copy.faq.map((x) => ({ ...x, cmp: false })), ...(comparison?.faq ?? []).map((x) => ({ ...x, cmp: true }))];

const subject = t.enquirySubject(p.name);
const og = productOgImage(p, lang);
const description = plain(f(copy.description));
const h1Text = kind ? `${p.name} – ${kind}` : p.name;
// Ebene 2 ist die Produktübersicht (/produkte/ bzw. /en/products/), nicht der Abschnitt der Startseite
const crumbs = [{ name: t.home, url: lang === 'de' ? '/' : '/en/' }, { name: t.products, url: productsUrlFor(lang) }, { name: p.name, url }];
const software = softwareApplication(p, page, lang, kind);
const jsonLd = [
  organization(lang),
  website(),
  webPage(url, seoTitle(copy.title), description, lang, software['@id'] as string, og),
  software,
  breadcrumbs(crumbs),
  faqPage(url, faqs.map((x) => ({ q: plain(f(x.q)), a: plain(f(x.a)) })), lang),
];
const updated = p.updated ? t.date(p.updated) : null;
---
<Base
  title={seoTitle(copy.title)}
  bareTitle
  description={description}
  lang={lang}
  alternates={[{ lang: 'de', href: productUrlFor(p, 'de') }, { lang: 'en', href: productUrlFor(p, 'en') }]}
  ogType="website"
  ogImage={og}
  ogImageAlt={h1Text}
  jsonLd={jsonLd}
>
  <section class:list={['dhero', ...colorClasses(p)]}>
    <div class="dhero-bg" aria-hidden="true"></div>
    <div class="container dhero-grid">
      <div class="dhero-copy">
        <div class="dtop">
          <nav aria-label={t.crumbs}>
            <ol class="crumbs">
              {crumbs.slice(0, -1).map((c) => <li><a href={c.url}>{c.name}</a></li>)}
              <li><span aria-current="page">{p.name}</span></li>
            </ol>
          </nav>
          <a class="dlang" href={otherUrl} hreflang={other} lang={other} title={t.otherLangLabel}>
            <Icon name="globe" /> {t.otherLang}
          </a>
        </div>
        <div class:list={['dhead', nameSize(p.name) && `dhead--${nameSize(p.name)}`]}>
          <ProductIcon product={p} size={76} uid="-hero" class="dicon" eager />
          {/* Ohne Leerraum zwischen den Teilen: sonst lesen Suchmaschinen „Vitrine  –  …“ mit doppelten Leerzeichen */}
          <h1><span class="dname" set:html={nameHtml(p.name)} />{kind && <><span class="visually-hidden"> – </span><span class="dkind">{kind}</span></>}</h1>
        </div>
        {tagline && <p class="dtag">{tagline}</p>}
        <p class="dlead" set:html={inline(f(copy.lead))} />
        {copy.independence && <p class="dindep">{copy.independence}</p>}
        <div class="dmeta">
          <StatusBadge product={p} label={statusLabel} />
          <a class="tag" href={lineAnchorFor(line.id, lang)}>{lineName}</a>
          {updated && <span class="dupdated">{t.updated}: <time datetime={p.updated}>{updated}</time></span>}
        </div>
        {lang === 'de' && p.highlights.length > 0 && (
          <ul class="tag-list dhl" aria-label={t.highlights}>
            {p.highlights.map((h) => <li class="hl-chip">{h}</li>)}
          </ul>
        )}
        <div class="btn-row dcta">
          {page.download.public && page.download.url ? (
            <>
              <a class="btn" href={page.download.url} rel="noopener"><Icon name="download" /> {t.download}</a>
              {page.download.source && <a class="btn btn--secondary" href={page.download.source} rel="noopener"><Icon name="code" /> {t.source}</a>}
            </>
          ) : (
            <>
              <a class="btn" href={mailto(subject)}><Icon name="mail" /> {t.enquiry}</a>
              {released && <a class="btn btn--secondary" href={mailto(t.supportSubject(p.name))}>{t.support}</a>}
            </>
          )}
        </div>
        {!page.download.public && (
          <p class="dnote-dl"><Icon name="info" /> {released ? `${t.downloadSoon}: ${t.downloadSoonHelp}` : t.inDevelopmentHelp}</p>
        )}
      </div>

      <div class="dhero-visual">
        {m.demo ? (
          <figure class="dvis dvis--shot">
            <div class="dvis-frame dvis-frame--demo">
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset={m.demo.still} />
                <img src={m.demo.src} width={m.demo.width} height={m.demo.height} alt={demoText!.alt} fetchpriority="high" />
              </picture>
            </div>
            {demoText?.caption && <figcaption>{demoText.caption}</figcaption>}
          </figure>
        ) : phones ? (
          <figure class="dvis dvis--phones">
            <div class="dvis-frame dvis-frame--phones">
              {heroPhones.map((x, i) => (
                <div class="dphone">
                  <ThemeImage light={x.light} dark={x.dark} alt={i === 0 ? txt(x).alt : ''} sizes="(min-width: 1100px) 190px, 28vw" eager={i === 0} />
                </div>
              ))}
            </div>
          </figure>
        ) : hero ? (
          <figure class="dvis dvis--shot">
            <div class="dvis-frame">
              <ThemeImage light={hero.light} dark={hero.dark} alt={txt(hero).alt} sizes="(min-width: 1100px) 620px, 92vw" eager />
            </div>
            <figcaption><strong>{txt(hero).title}</strong> {txt(hero).caption}</figcaption>
          </figure>
        ) : (
          <div class="dvis dvis--art" set:html={coverArt(p.slug, p.linie, '-hero')} />
        )}
      </div>
    </div>
  </section>

  <div class="container dbody">
    <div class="dmain">
      {copy.sections.map((s) => (
        <section class="dsec reveal" id={s.id} aria-labelledby={`s-${s.id}`}>
          <h2 id={`s-${s.id}`}>{s.title}</h2>
          {s.blocks.map((b) =>
            b.type === 'p' ? <p class="blk-p" set:html={inline(f(b.text))} />
            : b.type === 'list' ? <ul class="blk-ul">{b.items.map((x) => <li set:html={inline(f(x))} />)}</ul>
            : b.type === 'items' ? (
              <ul class:list={['feat-list', s.planned && 'feat-list--planned']} role="list">
                {b.items.map((x) => (
                  <li>
                    <Icon name={s.planned ? 'clock' : 'check'} class="feat-check" />
                    <div><h3>{x.title}</h3><p set:html={inline(f(x.text))} /></div>
                  </li>
                ))}
              </ul>
            ) : (
              <section class="table-wrap" tabindex="0" aria-label={b.caption}>
                <table class="dtable">
                  <caption class="visually-hidden">{b.caption}</caption>
                  <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                  <tbody>{b.rows.map((r) => <tr>{r.map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
                </table>
              </section>
            )
          )}
        </section>
      ))}

      {comparison && (
        <section class="dsec reveal" id={lang === 'de' ? 'alternative' : 'alternative-to'} aria-labelledby="s-alternativen" data-vergleich>
          <h2 id="s-alternativen">{comparison.title}</h2>
          {comparison.blocks.map((b) =>
            b.type === 'p' ? <p class="blk-p" set:html={inline(f(b.text))} />
            : b.type === 'list' ? <ul class="blk-ul">{b.items.map((x) => <li set:html={inline(f(x))} />)}</ul>
            : (
              <ul class="feat-list" role="list">
                {b.items.map((x) => (
                  <li>
                    <Icon name="check" class="feat-check" />
                    <div><h3>{x.title}</h3><p set:html={inline(f(x.text))} /></div>
                  </li>
                ))}
              </ul>
            )
          )}
          <p class="dcmp-tm" data-marken>{comparison.trademark}</p>
        </section>
      )}

      <section class="dsec reveal" id={lang === 'de' ? 'voraussetzungen' : 'requirements'} aria-labelledby="s-req">
        <h2 id="s-req">{t.requirements}</h2>
        <dl class="req">
          {copy.requirements.map(([k, v]) => <div><dt>{k}</dt><dd set:html={inline(f(v))} /></div>)}
        </dl>
      </section>

      <section class="dsec reveal" id={lang === 'de' ? 'grenzen' : 'limits'} aria-labelledby="s-limits">
        <h2 id="s-limits">{t.limits}</h2>
        <ul class="blk-ul">{copy.limits.map((x) => <li set:html={inline(f(x))} />)}</ul>
      </section>
    </div>

    <aside class="daside" aria-label={`${p.name}: ${t.glance}`}>
      <div class="card card--pad dfacts">
        <p class="daside-title">{t.glance}</p>
        <dl>
          <div><dt>{t.line}</dt><dd>{lineName}</dd></div>
          <div><dt>Status</dt><dd>{statusLabel}<span class="visually-hidden"> – </span><span class="dd-help">{page.download.public ? t.statusHelp[p.statusKey] : released ? t.downloadSoon : t.statusHelp[p.statusKey]}</span></dd></div>
          {released && p.version && <div><dt>{t.version}</dt><dd>{p.version}</dd></div>}
          {updated && <div><dt>{t.updated}</dt><dd><time datetime={p.updated}>{updated}</time></dd></div>}
          <div><dt>{t.licence}</dt><dd>{t.licenceValue(page.download.public)}</dd></div>
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        {privacy && <p class="dprivacy"><a href={privacy} hreflang="de">{t.privacy}</a></p>}
      </div>
      <div class="card card--pad dask">
        <p class="daside-title">{t.askTitle}</p>
        <p>{t.askText(p.name)}</p>
        <a class="btn" href={mailto(subject)}><Icon name="mail" /> {t.write}</a>
      </div>
    </aside>
  </div>

  {gallery.length > 0 && (
    <section class="container dgallery" aria-labelledby="s-bilder">
      <div class="dgallery-head">
        <h2 id="s-bilder">{t.gallery(p.name)}</h2>
        {galleryNote && <p class="muted">{galleryNote}</p>}
      </div>
      <ul class:list={['shots', phones && 'shots--phones']} role="list">
        {gallery.map((s) => (
          <li class:list={['reveal', `shot-item--${shotKind(s)}`]}>
            <figure>
              <a class:list={['shot', 'shot-link', shotKind(s) === 'phone' && 'shot--bare']} href={s.light.src} aria-label={t.galleryOpen(txt(s).title)}>
                <ThemeImage light={s.light} dark={s.dark} alt={txt(s).alt} sizes={shotKind(s) === 'wide' ? '(min-width: 1300px) 1240px, 94vw' : shotKind(s) === 'phone' ? '(min-width: 1100px) 260px, 44vw' : '(min-width: 1100px) 600px, (min-width: 720px) 46vw, 92vw'} />
              </a>
              <figcaption><strong>{txt(s).title}</strong>{txt(s).caption && <> <span>{txt(s).caption}</span></>}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container dfaq" id={lang === 'de' ? 'fragen' : 'faq'} aria-labelledby="s-faq">
    <h2 id="s-faq">{t.faq}</h2>
    <div class="faq-list">
      {faqs.map((x) => (
        <div class="faq-item reveal" data-vergleich={x.cmp ? '' : undefined}>
          <h3 set:html={inline(f(x.q))} />
          <p set:html={inline(f(x.a))} />
        </div>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section class="container drelated" aria-labelledby="s-related">
      <h2 id="s-related">{t.related}</h2>
      <ul class="rlist" role="list">
        {related.map((r) => (
          <li>
            <a class:list={['ritem', ...colorClasses(r)]} href={productUrlFor(r, lang)}>
              <ProductIcon product={r} size={44} uid="-rel" />
              <span class="rtext"><span class="rname">{r.name}</span>{relatedKind(r) && <><span class="visually-hidden"> – </span><span class="rkind">{relatedKind(r)}</span></>}</span>
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <GuideTeaser productId={p.id} lang={lang} />

  {copy.trademarks && <div class="container"><p class="dtm">{copy.trademarks}</p></div>}

  <ContactBand lang={lang} title={t.contactTitle(p.name)} subject={subject} text={t.contactText} />
</Base>

<style>
  .dhero { position: relative; overflow: clip; padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 5.5rem); }
  .dhero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46rem 30rem at 85% 10%, color-mix(in srgb, var(--l1) 30%, transparent), transparent 70%),
      radial-gradient(30rem 24rem at 100% 90%, color-mix(in srgb, var(--l2) 18%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 4.5%, transparent) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 90% 100% at 70% 20%, #000 30%, transparent 80%);
  }
  .dhero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .dtop { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2) var(--s-4); }
  .dlang {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg-elev);
    color: var(--ink-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
  }
  .dlang:hover { color: var(--ink); border-color: var(--ink-3); }
  .dlang :global(.icon) { width: 1em; height: 1em; }
  .dhead { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-2); }
  .dhead :global(.dicon) { --picon-size: 76px; }
  .dhead h1 { display: grid; min-width: 0; margin: 0; }
  /* Umbruch nur an den Stellen aus nameHtml() (keine automatische Silbentrennung von Markennamen);
     Größe nach dem längsten unteilbaren Teil des Namens (nameSize) */
  .dname { font-size: var(--fs-3xl); font-stretch: 106%; letter-spacing: -0.03em; line-height: 1.02; hyphens: manual; text-wrap: balance; }
  .dhead--long .dname { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.1rem); }
  .dhead--xlong .dname { font-size: clamp(1.8rem, 1.1rem + 2vw, 2.6rem); }
  .dkind { margin-top: 0.35rem; color: var(--ink-3); font-family: var(--font-sans); font-size: var(--fs-lg); font-weight: 560; font-stretch: 100%; letter-spacing: 0; line-height: 1.3; text-wrap: balance; }
  .dtag { margin-top: var(--s-5); max-width: 24ch; font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; font-stretch: 104%; line-height: 1.2; letter-spacing: -0.015em; text-wrap: balance; color: var(--ink); }
  .dlead { margin-top: var(--s-4); max-width: 60ch; color: var(--ink-2); font-size: var(--fs-lg); line-height: 1.55; }
  .dmeta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); margin-top: var(--s-5); }
  .dupdated { color: var(--ink-3); font-size: var(--fs-xs); font-weight: 560; }
  .dhl { margin-top: var(--s-4); }
  .hl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.85em 0.35em 0.7em;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg-elev);
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .hl-chip::before { content: ""; width: 0.45em; height: 0.45em; border-radius: 2px; background: linear-gradient(135deg, var(--l1), var(--l2)); }
  .dcta { margin-top: var(--s-6); }
  .dindep { margin-top: var(--s-3); max-width: 60ch; color: var(--ink-3); font-size: var(--fs-sm); }
  .dnote-dl { display: flex; gap: 0.5em; align-items: flex-start; margin-top: var(--s-3); max-width: 56ch; color: var(--ink-3); font-size: var(--fs-sm); }
  .dnote-dl :global(.icon) { flex: none; width: 1.1em; height: 1.1em; margin-top: 0.2em; }

  .dvis { position: relative; margin: 0; }
  .dvis-frame { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .dvis-frame {
    position: relative;
    padding: clamp(14px, 2.5vw, 28px) 0 0 clamp(14px, 2.5vw, 28px);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.32), transparent 55%),
      linear-gradient(135deg, var(--l1), var(--l2));
  }
  .dvis-frame--demo { padding: clamp(10px, 1.6vw, 18px); }
  .dvis-frame--demo img { width: 100%; height: auto; border-radius: 10px; }
  .dvis-frame :global(img) { width: 100%; height: auto; border-radius: 10px 0 0 0; box-shadow: 0 -8px 30px -8px rgb(0 0 0 / 0.35); }
  .dvis--shot figcaption { margin-top: var(--s-3); color: var(--ink-3); font-size: var(--fs-sm); }
  .dvis--shot figcaption strong { color: var(--ink); margin-right: 0.3em; }
  .dvis-frame--phones { display: flex; justify-content: center; gap: 5%; padding: clamp(18px, 3vw, 36px) clamp(12px, 2vw, 24px) 0; aspect-ratio: 16 / 11; }
  .dphone { width: 29%; flex: none; filter: drop-shadow(0 18px 26px rgb(0 0 0 / 0.35)); }
  .dphone:nth-child(2) { margin-top: 8%; }
  .dphone:nth-child(3) { margin-top: 16%; }
  .dvis-frame--phones :global(img) { width: 100%; height: auto; border-radius: 0; box-shadow: none; }
  .dvis--art { aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-lg); box-shadow: var(--shadow-lg); background: linear-gradient(135deg, var(--l1), var(--l2)); }
  .dvis--art :global(.art) { width: 100%; height: 100%; }

  .dbody { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  /* minmax(0, 1fr): sonst wächst die Spalte auf die Mindestbreite breiter Tabellen und alles läuft rechts hinaus */
  .dmain { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-8); min-width: 0; counter-reset: dsec; }
  .dsec { scroll-margin-top: 96px; counter-increment: dsec; }
  .dsec h2 { display: flex; align-items: baseline; gap: 0.6em; margin-bottom: var(--s-4); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); overflow-wrap: anywhere; hyphens: auto; }
  /* Laufende Nummer nur als Gestaltung: per CSS-Zähler, damit sie nicht im Text der Überschrift steht (Suchmaschinen
     läsen sonst „01 QR-Code am PC scannen“); „/ ''“ hält sie auch aus der Sprachausgabe heraus */
  .dsec h2::before {
    content: counter(dsec, decimal-leading-zero);
    content: counter(dsec, decimal-leading-zero) / '';
    flex: none;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
