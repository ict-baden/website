---
import type { Product } from '../lib/products';
interface Props { product: Pick<Product, 'statusKey' | 'statusLabel'>; class?: string; label?: string }
const { product, class: className, label } = Astro.props;
---
<span class:list={['badge', `badge--${product.statusKey}`, className]}><span class="visually-hidden">Status: </span>{label ?? product.statusLabel}</span>
