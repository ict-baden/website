---
// Bild mit heller und (optional) dunkler Fassung; sichtbar ist die zum aktiven Design passende.
// eager (Bild oben auf der Seite, oft das LCP-Element): <picture> mit einer Quelle für das dunkle Systemdesign –
// der Browser lädt nur die passende Fassung, und zwar mit hoher Priorität. Wer das Design über den Schalter
// abweichend vom System gewählt hat, bekommt die dunklen Quellen von public/js/site.js umgestellt (data-theme-pic,
// data-dark). Sonst zwei <picture>, per CSS umgeschaltet (.theme-light/.theme-dark in base.css); die dunkle Fassung
// lädt lazy. Jede Fassung zusätzlich als AVIF (scripts/make-avif.mjs), wo die Dateien vorhanden sind – WebP bleibt
// der Rückfall für ältere Browser.
import { existsSync } from 'node:fs';
import type { ImageSet } from '../lib/products';

interface Props {
  light: ImageSet;
  dark?: ImageSet | null;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { light, dark, alt, sizes, eager = false, class: className } = Astro.props;
const common = { sizes, loading: eager ? ('eager' as const) : ('lazy' as const), decoding: 'async' as const };
/** srcset der AVIF-Fassung, wenn alle Dateien dazu existieren */
const avif = (set: ImageSet | null | undefined) => {
  if (!set || !set.srcset.includes('.webp')) return null;
  const srcset = set.srcset.replaceAll('.webp', '.avif');
  const files = srcset.split(',').map((x) => x.trim().split(/\s+/)[0]);
  return files.every((f) => existsSync(`public${f}`)) ? srcset : null;
};
const lightAvif = avif(light);
const darkAvif = avif(dark);
---
{eager && dark ? (
  <picture class="theme-pic" data-theme-pic>
    {darkAvif && <source data-dark media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkAvif} sizes={sizes} width={dark.width} height={dark.height} />}
    <source data-dark media="(prefers-color-scheme: dark)" type="image/webp" srcset={dark.srcset} sizes={sizes} width={dark.width} height={dark.height} />
    {lightAvif && <source type="image/avif" srcset={lightAvif} sizes={sizes} width={light.width} height={light.height} />}
    <img class={className} src={light.src} srcset={light.srcset} width={light.width} height={light.height} alt={alt} {...common} fetchpriority="high" />
  </picture>
) : (
  <>
    <picture class:list={['theme-pic', dark && 'theme-light']}>
      {lightAvif && <source type="image/avif" srcset={lightAvif} sizes={sizes} width={light.width} height={light.height} />}
      <img class={className} src={light.src} srcset={light.srcset} width={light.width} height={light.height} alt={alt} {...common} fetchpriority={eager ? 'high' : undefined} />
    </picture>
    {/* dunkle Fassung immer lazy: ausgeblendete Bilder lädt der Browser erst, wenn sie sichtbar werden */}
    {dark && (
      <picture class="theme-pic theme-dark">
        {darkAvif && <source type="image/avif" srcset={darkAvif} sizes={sizes} width={dark.width} height={dark.height} />}
        <img class={className} src={dark.src} srcset={dark.srcset} width={dark.width} height={dark.height} alt={alt} sizes={sizes} loading="lazy" decoding="async" />
      </picture>
    )}
  </>
)}
