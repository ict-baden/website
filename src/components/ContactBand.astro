---
import Icon from './Icon.astro';
import { COMPANY, mailto } from '../config';

interface Props {
  title?: string;
  text?: string;
  subject?: string;
  lang?: 'de' | 'en';
}
const {
  title = 'Sprechen wir über Ihr Projekt.',
  text = 'Ob Softwareentwicklung im Auftrag oder eines unserer Produkte – am schnellsten geht es per E-Mail oder Telefon.',
  subject = 'Anfrage über die Website',
  lang = 'de',
} = Astro.props;
---
<section class="cband" aria-labelledby="cband-titel">
  <div class="container">
    <div class="cband-inner reveal">
      <span class="cband-bar" aria-hidden="true"></span>
      <div class="cband-copy">
        <p class="eyebrow">{lang === 'en' ? 'Contact' : 'Kontakt'}</p>
        <h2 id="cband-titel">{title}</h2>
        <p class="cband-text">{text}</p>
      </div>
      <div class="cband-actions">
        <a class="btn cband-btn" href={mailto(subject)}><Icon name="mail" /> {COMPANY.email}</a>
        <a class="btn btn--secondary cband-btn tel" href={COMPANY.mobileHref}><Icon name="phone" /> {COMPANY.mobile}</a>
        <p class="cband-addr"><Icon name="pin" /><span>{COMPANY.street}, {COMPANY.zip}&nbsp;{COMPANY.city}{lang === 'en' && ', Germany'}&nbsp;·&nbsp;<a href="/kontakt/#anfahrt" hreflang={lang === 'en' ? 'de' : undefined}>{lang === 'en' ? 'Directions (German)' : 'Anfahrt'}</a></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .cband { padding-top: var(--section-y); }
  :global(.section) + .cband { padding-top: 0; }
  .cband-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    padding: clamp(1.75rem, 1rem + 4vw, 4.5rem);
    overflow: hidden;
    border-radius: var(--r-xl);
    /* Fläche in Baden-Gelb mit dem Schrägbalken aus dem Logo an der rechten Kante */
    background: var(--brand-yellow);
    color: #111111;
    --ink: #111111;
    --ink-2: #2d2c26;
    --ink-3: #3f3e38;
    --link: #111111;
    --link-line: #111111;
    --link-hover: #111111;
    --focus: #111111;
    --btn-bg: #111111;
    --btn-ink: var(--brand-yellow);
    --btn-bg-hover: #ffffff;
    --btn-ink-hover: #111111;
  }
  .cband-inner > :not(.cband-bar) { position: relative; }
  .cband-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(100% - clamp(64px, 7vw, 104px));
    width: clamp(22px, 2.6vw, 38px);
    background: var(--brand-red);
    transform: skewX(var(--bar-angle));
    transform-origin: 0 0;
  }
  .cband .eyebrow { color: #111111; }
  .cband .eyebrow::before { background: linear-gradient(116.565deg, #111111 0 58%, var(--brand-red) 58% 80%, #111111 80%); box-shadow: none; }
  .cband :global(.btn--secondary) { --_bg: transparent; --_ink: #111111; border-color: rgb(17 17 17 / 0.55); background: rgb(255 255 255 / 0.2); }
  .cband :global(.btn--secondary:hover) { background: rgb(255 255 255 / 0.6); border-color: #111111; color: #111111; }
  .cband h2 { font-size: var(--fs-2xl); }
  .cband-text { margin-top: var(--s-4); color: var(--ink-2); font-size: var(--fs-lg); line-height: 1.55; max-width: 44ch; }
  .cband-actions { display: grid; gap: var(--s-3); justify-items: stretch; }
  .cband-btn { justify-content: flex-start; min-height: 56px; padding-inline: 1.4rem; font-size: var(--fs-base); }
  .cband-addr { display: flex; align-items: flex-start; gap: 0.5em; margin-top: var(--s-2); color: var(--ink-2); font-size: var(--fs-sm); }
  .cband-addr :global(.icon) { width: 1.05rem; height: 1.05rem; margin-top: 0.2em; color: #111111; }
  @media (max-width: 860px) {
    .cband-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .cband-btn { font-size: var(--fs-sm); padding-inline: 1rem; }
  }
</style>
