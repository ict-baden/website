{
  "name": "ict-baden-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website of ICT Baden GmbH – consulting, custom software development and own software products.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync:products": "node scripts/sync-products.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "icons": "node scripts/make-product-icons.mjs",
    "check:products": "node scripts/check-products.mjs",
    "check:links": "node scripts/check-links.mjs dist",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:a11y": "node scripts/check-a11y.mjs dist",
    "check": "npm run check:products && npm test && npm run check:links && npm run check:html && npm run check:a11y",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node scripts/test-pulse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "html-validate": "11.16.2",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5"
  }
}
