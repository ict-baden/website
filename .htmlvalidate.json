{
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "no-redundant-role": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "doctype-style": "off",
    "no-inline-style": "error",
    "tel-non-breaking": ["error", { "ignoreClasses": ["tel"] }]
  }
}
